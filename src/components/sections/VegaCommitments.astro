---
import SectionHeader from '@/components/ui/SectionHeader.astro';

export type CommitmentItem = {
	title: string;
	description: string;
	icon?: string;        // raw SVG string
	tagline?: string;     // italic accent line at the bottom
	variant?: 'light' | 'dark';
};

type Props = {
	sectionTitle?: string;
	sectionSubtitle?: string;
	items: CommitmentItem[];
};

const {
	sectionTitle = 'Our Commitments',
	sectionSubtitle,
	items,
} = Astro.props;

// First 2 items → featured row (2-col), remainder → secondary row (3-col)
const featured = items.slice(0, 2);
const secondary = items.slice(2);
---

<section class="commitments">
	<div class="container">

		<!-- Header -->
		<SectionHeader title={sectionTitle} subtitle={sectionSubtitle} data-animate="fade-up" />

		<!-- Featured row (2-col) -->
		{featured.length > 0 && (
			<div class="commitments__featured">
				{featured.map((item) => (
					<div class:list={['card', item.variant === 'dark' ? 'card--dark' : 'card--light']} data-animate="fade-up" data-animate-stagger="0.08">
						{item.icon && (
							<span class="card__icon" set:html={item.icon} />
						)}
						<div class="card__body">
							<h3 class="card__title">{item.title}</h3>
							<p class="card__description">{item.description}</p>
							{item.tagline && <p class="card__tagline">{item.tagline}</p>}
						</div>
					</div>
				))}
			</div>
		)}

		<!-- Secondary row (3-col) -->
		{secondary.length > 0 && (
			<div class="commitments__secondary">
				{secondary.map((item) => (
					<div class:list={['card', item.variant === 'dark' ? 'card--dark' : 'card--light']} data-animate="fade-up-sm" data-animate-stagger="0.06">
						{item.icon && (
							<span class="card__icon" set:html={item.icon} />
						)}
						<div class="card__body">
							<h3 class="card__title">{item.title}</h3>
							<p class="card__description">{item.description}</p>
							{item.tagline && <p class="card__tagline">{item.tagline}</p>}
						</div>
					</div>
				))}
			</div>
		)}

	</div>
</section>


<style>
	.commitments {
		background: var(--color-bg, #FAF6EE);
		padding: 5.5rem 0 4.5rem;
	}

	/* ── Grids ───────────────────────────────────────────────── */
	.commitments__featured {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
		margin-bottom: 1.25rem;
	}

	.commitments__secondary {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 768px) {
		.commitments__featured,
		.commitments__secondary {
			grid-template-columns: 1fr;
		}
	}

	/* ── Card base ───────────────────────────────────────────── */
	.card {
		border-radius: var(--radius-dashed, 20px);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		position: relative;
		overflow: hidden;
	}

	.card__body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex: 1;
	}

	.card__icon {
		display: flex;
		align-items: center;
		color: var(--color-text-light, #9A9186);
		width: 2rem;
		height: 2rem;
		flex-shrink: 0;
	}

	.card__icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	.card__title {
		font-family: var(--font-primary), sans-serif;
		font-size: 1.1rem;
		font-weight: 800;
		line-height: 1.3;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	.card__title::before {
		content: '';
		display: inline-block;
		width: 6px;
		height: 6px;
		background: currentColor;
		opacity: 0.7;
		transform: rotate(45deg);
		margin-right: 0.55em;
		vertical-align: 0.14em;
	}

	.card__description {
		font-size: 0.92rem;
		line-height: 1.75;
	}

	.card__tagline {
		font-family: var(--font-secondary), sans-serif;
		font-size: 0.88rem;
		margin-top: 0.25rem;
		letter-spacing: 0;
	}

	/* ── Light variant ───────────────────────────────────────── */
	.card--light {
		background: var(--color-bg-muted, #F1EADD);
		border: 2px dashed var(--color-border-dashed, #6B9C86);
	}

	.card--light .card__title {
		color: var(--color-charcoal, #221E1A);
	}

	.card--light .card__description {
		color: var(--color-text-muted, #6B6560);
	}

	.card--light .card__tagline {
		color: var(--color-accent, #7C2E28);
	}

	/* ── Dark variant ────────────────────────────────────────── */
	.card--dark {
		background: var(--color-bg-dark, #1F332A);
	}

	.card--dark .card__icon {
		color: rgba(255, 255, 255, 0.2);
		position: absolute;
		bottom: 1.5rem;
		right: 1.5rem;
		width: 5rem;
		height: 5rem;
	}

	.card--dark .card__title {
		color: var(--color-bg, #FAF6EE);
	}

	.card--dark .card__description {
		color: rgba(250, 246, 238, 0.65);
	}

	.card--dark .card__tagline {
		color: rgba(250, 246, 238, 0.55);
	}

</style>
