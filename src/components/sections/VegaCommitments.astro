---
import SectionHeader from '@/components/ui/SectionHeader.astro';

export type CommitmentItem = {
	title: string;
	description: string;
	icon?: string;        // raw SVG string
	tagline?: string;     // italic accent line at the bottom
	variant?: 'light' | 'dark';
};

type Props = {
	sectionTitle?: string;
	sectionSubtitle?: string;
	items: CommitmentItem[];
};

const {
	sectionTitle = 'Our Commitments',
	sectionSubtitle,
	items,
} = Astro.props;

// First 2 items → featured row (2-col), remainder → secondary row (3-col)
const featured = items.slice(0, 2);
const secondary = items.slice(2);
---

<section class="commitments">
	<div class="container">

		<!-- Header -->
		<SectionHeader title={sectionTitle} subtitle={sectionSubtitle} data-animate="fade-up" />

		<!-- Featured row (2-col) -->
		{featured.length > 0 && (
			<div class="commitments__featured">
				{featured.map((item) => (
					<div class:list={['card', item.variant === 'dark' ? 'card--dark' : 'card--light']} data-animate="fade-up" data-animate-stagger="0.08">
						{item.icon && (
							<span class="card__icon" set:html={item.icon} />
						)}
						<div class="card__body">
							<h3 class="card__title">{item.title}</h3>
							<p class="card__description">{item.description}</p>
							{item.tagline && <p class="card__tagline">{item.tagline}</p>}
						</div>
					</div>
				))}
			</div>
		)}

		<!-- Secondary row (3-col) -->
		{secondary.length > 0 && (
			<div class="commitments__secondary">
				{secondary.map((item) => (
					<div class:list={['card', item.variant === 'dark' ? 'card--dark' : 'card--light']} data-animate="fade-up-sm" data-animate-stagger="0.06">
						{item.icon && (
							<span class="card__icon" set:html={item.icon} />
						)}
						<div class="card__body">
							<h3 class="card__title">{item.title}</h3>
							<p class="card__description">{item.description}</p>
							{item.tagline && <p class="card__tagline">{item.tagline}</p>}
						</div>
					</div>
				))}
			</div>
		)}

	</div>
</section>


<style>
	.commitments {
		background: #F7F4F0;
		padding: 5rem 0 4rem;
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* ── Grids ───────────────────────────────────────────────── */
	.commitments__featured {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
		margin-bottom: 1.25rem;
	}

	.commitments__secondary {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 768px) {
		.commitments__featured,
		.commitments__secondary {
			grid-template-columns: 1fr;
		}
	}

	/* ── Card base ───────────────────────────────────────────── */
	.card {
		border-radius: var(--radius);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		position: relative;
		overflow: hidden;
	}

	.card__body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex: 1;
	}

	.card__icon {
		display: flex;
		align-items: center;
		color: #8A9AB0;
		width: 2rem;
		height: 2rem;
		flex-shrink: 0;
	}

	.card__icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	.card__title {
		font-family: var(--font-primary), Georgia, serif;
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1.25;
	}

	.card__description {
		font-size: 0.92rem;
		line-height: 1.7;
	}

	.card__tagline {
		font-family: Georgia, 'Times New Roman', serif;
		font-style: italic;
		font-size: 0.9rem;
		margin-top: 0.25rem;
	}

	/* ── Light variant ───────────────────────────────────────── */
	.card--light {
		background: #F0EDE8;
		border: 1.5px dashed #D6CFC6;
	}

	.card--light .card__title {
		color: #2D3A5C;
	}

	.card--light .card__description {
		color: #6B7A8D;
	}

	.card--light .card__tagline {
		color: #8A9AB0;
	}

	/* ── Dark variant ────────────────────────────────────────── */
	.card--dark {
		background: #2D3A5C;
	}

	.card--dark .card__icon {
		color: rgba(255, 255, 255, 0.3);
		position: absolute;
		bottom: 1.5rem;
		right: 1.5rem;
		width: 5rem;
		height: 5rem;
	}

	.card--dark .card__title {
		color: #fff;
	}

	.card--dark .card__description {
		color: rgba(255, 255, 255, 0.7);
	}

	.card--dark .card__tagline {
		color: rgba(255, 255, 255, 0.5);
	}

</style>
