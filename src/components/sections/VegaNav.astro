---
import type { ImageMetadata } from 'astro';
import Brandmark from '@/components/ui/Brandmark.astro';

type NavLink = { label: string; url: string };
type NavGroup = { label: string; children: NavLink[] };
type NavItem = NavLink | NavGroup;

function isGroup(item: NavItem): item is NavGroup {
	return "children" in item;
}

type Props = {
	logoSrc?: ImageMetadata | string;
	logoAlt?: string;
	links?: NavItem[];
	cta?: { label: string; url: string };
	currentPath?: string;
};

const {
	logoSrc,
	logoAlt = "Tarrytown Local",
	links = [],
	cta,
	currentPath = Astro.url.pathname,
} = Astro.props;
---

<header class="vega-nav">
	<div class="container">
		<!-- Wordmark / Logo -->
		<a href="/" class="nav-brand">
			<Brandmark logoSrc={logoSrc} logoAlt={logoAlt} size="compact" />
		</a>

		<!-- Hamburger toggle (mobile) -->
		<button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
			<span></span>
			<span></span>
			<span></span>
		</button>

		<!-- Links + CTA -->
		<nav id="nav-menu" class="nav-menu" role="navigation">
			<ul class="nav-links">
				{links.map((item) => {
					if (isGroup(item)) {
						const isActive = item.children.some(
							(child) => currentPath === child.url || currentPath.startsWith(child.url + "/")
						);
						return (
							<li class="nav-group">
								<span
									role="button"
									tabindex="0"
									aria-haspopup="true"
									class:list={["nav-link", "nav-link--group", { "nav-link--active": isActive }]}
									aria-expanded="false"
								>
									{item.label}
									<svg class="nav-caret" width="8" height="5" viewBox="0 0 8 5" aria-hidden="true">
										<path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</span>
								<ul class="nav-dropdown">
									{item.children.map((child) => {
										const childActive = currentPath === child.url || currentPath.startsWith(child.url + "/");
										return (
											<li>
												<a
													href={child.url}
													class:list={["nav-dropdown-link", { "nav-dropdown-link--active": childActive }]}
												>
													{child.label}
												</a>
											</li>
										);
									})}
								</ul>
							</li>
						);
					}

					const isActive = currentPath === item.url || currentPath.startsWith(item.url + "/");
					return (
						<li>
							<a
								href={item.url}
								class:list={["nav-link", { "nav-link--active": isActive }]}
							>
								{item.label}
							</a>
						</li>
					);
				})}
			</ul>

			{cta && (
				<a href={cta.url} class="nav-cta">{cta.label}</a>
			)}
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector(".nav-toggle") as HTMLButtonElement;
	const menu = document.querySelector(".nav-menu") as HTMLElement;

	toggle?.addEventListener("click", () => {
		const open = toggle.getAttribute("aria-expanded") === "true";
		toggle.setAttribute("aria-expanded", String(!open));
		menu.classList.toggle("nav-menu--open", !open);
	});

	const groups = document.querySelectorAll<HTMLLIElement>(".nav-group");
	const isMobile = () => window.matchMedia("(max-width: 680px)").matches;

	function closeAllGroups(except?: HTMLLIElement) {
		groups.forEach((group) => {
			if (group === except) return;
			group.classList.remove("nav-group--open");
			group.querySelector('[role="button"]')?.setAttribute("aria-expanded", "false");
		});
	}

	// Desktop opens on hover (CSS); click/keyboard toggle is only wired up
	// for mobile, where there's no hover state and the dropdown expands inline.
	groups.forEach((group) => {
		const trigger = group.querySelector<HTMLElement>('[role="button"]');
		const toggleGroup = (event: Event) => {
			if (!isMobile() || !trigger) return;
			event.stopPropagation();
			const open = group.classList.contains("nav-group--open");
			closeAllGroups(group);
			group.classList.toggle("nav-group--open", !open);
			trigger.setAttribute("aria-expanded", String(!open));
		};
		trigger?.addEventListener("click", (event) => {
			if (isMobile()) {
				toggleGroup(event);
				return;
			}
			// On desktop the dropdown is purely hover-driven. A click still focuses
			// this element though, and :focus-within would then keep the dropdown
			// open even after the mouse moves away. Blur it so hover is back in
			// sole control — this is what was causing dropdowns to stick open.
			trigger.blur();
		});
		trigger?.addEventListener("keydown", (event) => {
			if (event.key === "Enter" || event.key === " ") {
				event.preventDefault();
				toggleGroup(event);
			}
		});
	});

	document.addEventListener("click", () => {
		if (isMobile()) closeAllGroups();
	});
	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeAllGroups();
	});
</script>

<style lang="scss">
	.vega-nav {
		--nav-charcoal: var(--color-charcoal, #221E1A);
		--nav-muted:    var(--color-text-muted, #6B6560);
		--nav-bg:       var(--color-bg, #FAF6EE);
		--nav-border:   var(--color-border, #E4DCCB);
		--nav-olive:    var(--color-primary, #2E4A3B);
		--nav-height:   84px;

		background: var(--nav-bg);
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--nav-border);

		.container {
			height: var(--nav-height);
			display: flex;
			align-items: center;
			gap: 1.5rem;
		}

		// Brand
		.nav-brand {
			text-decoration: none;
			flex-shrink: 0;
		}

		// Menu
		.nav-menu {
			display: flex;
			align-items: center;
			gap: 1.25rem;
			margin-left: auto;
		}

		.nav-links {
			display: flex;
			align-items: center;
			gap: 0;
			list-style: none;
			padding: 0;
			margin: 0;
		}

		.nav-link {
			display: block;
			padding: 0.85em 0.9em;
			font-size: 0.85rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--nav-muted);
			text-decoration: none;
			position: relative;
			white-space: nowrap;
			transition: color 0.2s ease;

			&::after {
				content: "";
				position: absolute;
				bottom: 0.15em;
				left: 0.9em;
				right: 0.9em;
				height: 1px;
				background: var(--color-accent, #7C2E28);
				transform: scaleX(0);
				transition: transform 0.25s ease;
				transform-origin: left;
			}

			&:hover {
				color: var(--nav-charcoal);
			}

			&.nav-link--active {
				color: var(--nav-charcoal);

				&::after {
					transform: scaleX(1);
				}
			}
		}

		.nav-link--group {
			display: inline-flex;
			align-items: center;
			gap: 0.35em;
			cursor: pointer;
		}

		.nav-caret {
			flex-shrink: 0;
			transition: transform 0.2s ease;
		}

		// Dropdown groups
		.nav-group {
			position: relative;

			.nav-dropdown {
				position: absolute;
				top: 100%;
				left: 0;
				min-width: 210px;
				margin: 0;
				padding: 0.5rem 0;
				list-style: none;
				background: var(--nav-bg);
				border: 1px solid var(--nav-border);
				box-shadow: 0 8px 24px rgba(34, 30, 26, 0.08);
				opacity: 0;
				visibility: hidden;
				transform: translateY(4px);
				transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
			}

			&.nav-group--open {
				.nav-dropdown {
					opacity: 1;
					visibility: visible;
					transform: translateY(0);
				}

				.nav-caret {
					transform: rotate(180deg);
				}
			}
		}

		@media (min-width: 681px) {
			// Desktop: hover (or keyboard focus) reveals the dropdown directly —
			// no click needed, and no lingering open state to manage.
			.nav-group:hover,
			.nav-group:focus-within {
				.nav-dropdown {
					opacity: 1;
					visibility: visible;
					transform: translateY(0);
				}

				.nav-caret {
					transform: rotate(180deg);
				}
			}
		}

		.nav-dropdown-link {
			display: block;
			padding: 0.85em 1.25rem;
			border-left: 3px solid transparent;
			font-size: 0.78rem;
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--nav-muted);
			text-decoration: none;
			white-space: nowrap;
			transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;

			&:hover {
				color: var(--nav-charcoal);
				background: var(--nav-border);
			}

			&.nav-dropdown-link--active {
				color: var(--nav-charcoal);
				font-weight: 700;
				background: var(--nav-border);
				border-left-color: var(--color-accent, #7C2E28);
			}
		}

		// CTA button — editorial outlined style
		.nav-cta {
			flex-shrink: 0;
			display: inline-block;
			padding: 0.75em 1.5em;
			background: transparent;
			color: var(--nav-charcoal);
			font-size: 0.8rem;
			font-weight: 600;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			border: 1.5px solid var(--nav-charcoal);
			border-radius: 0;
			box-shadow: var(--shadow-hard);
			text-decoration: none;
			transition: background 0.2s ease, color 0.2s ease;

			&:hover {
				background: var(--nav-charcoal);
				color: var(--nav-bg);
			}
		}

		// Hamburger
		.nav-toggle {
			display: none;
			flex-direction: column;
			justify-content: center;
			gap: 5px;
			width: 32px;
			height: 32px;
			background: none;
			border: none;
			cursor: pointer;
			margin-left: auto;
			padding: 0;

			span {
				display: block;
				width: 100%;
				height: 1px;
				background: var(--nav-charcoal);
				transition: transform 0.2s ease, opacity 0.2s ease;
			}
		}

		// Mobile
		@media (max-width: 680px) {
			.nav-toggle {
				display: flex;
			}

			.nav-menu {
				display: none;
				position: absolute;
				top: var(--nav-height);
				left: 0;
				right: 0;
				background: var(--nav-bg);
				flex-direction: column;
				align-items: flex-start;
				gap: 0;
				padding: 1rem 1.5rem 1.5rem;
				border-bottom: 1px solid var(--nav-border);

				&.nav-menu--open {
					display: flex;
				}
			}

			.nav-links {
				flex-direction: column;
				align-items: flex-start;
				width: 100%;
				gap: 0;
			}

			.nav-link {
				padding: 1em 0;
				width: 100%;
				text-align: left;
				font-size: 0.9rem;

				&::after {
					left: 0;
					right: auto;
					width: 1.5em;
				}
			}

			.nav-link--group {
				justify-content: space-between;
			}

			.nav-group {
				width: 100%;

				.nav-dropdown {
					position: static;
					width: 100%;
					border: none;
					box-shadow: none;
					padding: 0 0 0 1rem;
					background: transparent;
					opacity: 1;
					visibility: visible;
					transform: none;
					max-height: 0;
					overflow: hidden;
					transition: max-height 0.2s ease;
				}

				&.nav-group--open .nav-dropdown {
					max-height: 400px;
				}
			}

			.nav-dropdown-link {
				padding: 0.85em 0 0.85em 0.75rem;
				font-size: 0.85rem;

				&:hover {
					background: transparent;
				}

				&.nav-dropdown-link--active {
					background: transparent;
				}
			}

			.nav-cta {
				margin-top: 1rem;
			}
		}
	}
</style>
