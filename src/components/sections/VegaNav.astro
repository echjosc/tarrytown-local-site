---
import type { ImageMetadata } from "astro";
import Brandmark from "@/components/ui/Brandmark.astro";

type NavLink = { label: string; url: string };
type NavGroup = { label: string; children: NavLink[] };
type NavItem = NavLink | NavGroup;

function isGroup(item: NavItem): item is NavGroup {
	return "children" in item;
}

type Props = {
	logoSrc?: ImageMetadata | string;
	logoAlt?: string;
	links?: NavItem[];
	cta?: { label: string; url: string };
	secondaryCta?: { label: string; url: string };
	currentPath?: string;
};

const {
	logoSrc,
	logoAlt = "Tarrytown Local",
	links = [],
	cta,
	secondaryCta,
	currentPath = Astro.url.pathname,
} = Astro.props;

const isCurrent = (url: string) =>
	currentPath === url || currentPath.startsWith(url + "/");
---

<header class="vega-nav">
	<div class="container">
		<!-- Wordmark / Logo -->
		<a href="/" class="nav-brand">
			<Brandmark
				logoSrc={logoSrc}
				logoAlt={logoAlt}
				size="compact"
				loading="eager"
			/>
		</a>

		<!-- Hamburger toggle (mobile) -->
		<button
			type="button"
			class="nav-toggle"
			aria-label="Toggle menu"
			aria-expanded="false"
			aria-controls="nav-menu"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>

		<!-- Links + CTA -->
		<nav id="nav-menu" class="nav-menu" aria-label="Main">
			<div class="nav-menu__inner">
				<ul class="nav-links">
					{
						links.map((item) => {
							if (isGroup(item)) {
								const isActive = item.children.some((child) =>
									isCurrent(child.url),
								);
								return (
									<li class="nav-group">
										<button
											type="button"
											class:list={[
												"nav-link",
												"nav-link--group",
												{ "nav-link--active": isActive },
											]}
											aria-expanded="false"
										>
											{item.label}
											<svg
												class="nav-caret"
												width="8"
												height="5"
												viewBox="0 0 8 5"
												aria-hidden="true"
											>
												<path
													d="M1 1L4 4L7 1"
													stroke="currentColor"
													stroke-width="1.4"
													fill="none"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
										</button>
										<ul class="nav-dropdown">
											{item.children.map((child) => {
												const childActive = isCurrent(child.url);
												return (
													<li>
														<a
															href={child.url}
															class:list={[
																"nav-dropdown-link",
																{
																	"nav-dropdown-link--active":
																		childActive,
																},
															]}
															aria-current={
																childActive ? "page" : undefined
															}
														>
															{child.label}
														</a>
													</li>
												);
											})}
										</ul>
									</li>
								);
							}

							const isActive = isCurrent(item.url);
							return (
								<li>
									<a
										href={item.url}
										class:list={[
											"nav-link",
											{ "nav-link--active": isActive },
										]}
										aria-current={isActive ? "page" : undefined}
									>
										{item.label}
									</a>
								</li>
							);
						})
					}
				</ul>

				{
					cta && (
						<a href={cta.url} class="nav-cta">
							{cta.label}
						</a>
					)
				}

				{
					secondaryCta && (
						<a href={secondaryCta.url} class="nav-cta nav-cta--solid">
							{secondaryCta.label}
						</a>
					)
				}
			</div>
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
	const menu = document.querySelector<HTMLElement>(".nav-menu");
	const groups = document.querySelectorAll<HTMLLIElement>(".nav-group");
	const mobileQuery = window.matchMedia("(max-width: 1180px)");
	const isMobile = () => mobileQuery.matches;

	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

	function setMenuOpen(open: boolean) {
		toggle?.setAttribute("aria-expanded", String(open));
		menu?.classList.toggle("nav-menu--open", open);
		// Scrolling stays off while animating so no scrollbar flickers in.
		// With reduced motion there's no transition (and no transitionend), so settle now.
		menu?.classList.toggle("nav-menu--settled", open && reducedMotion.matches);
		if (!open) closeAllGroups();
	}

	menu?.addEventListener("transitionend", (event) => {
		if (
			event.target === menu &&
			event.propertyName === "grid-template-rows" &&
			menu.classList.contains("nav-menu--open")
		) {
			menu.classList.add("nav-menu--settled");
		}
	});

	function closeAllGroups(except?: HTMLLIElement) {
		groups.forEach((group) => {
			if (group === except) return;
			group.classList.remove("nav-group--open");
			group
				.querySelector(".nav-link--group")
				?.setAttribute("aria-expanded", "false");
		});
	}

	toggle?.addEventListener("click", () => {
		setMenuOpen(toggle.getAttribute("aria-expanded") !== "true");
	});

	// Desktop opens on hover/focus (CSS). The click toggle is only for mobile,
	// where there's no hover and the dropdown expands inline.
	// A <button> fires "click" for Enter and Space too, so no keydown handler is needed.
	groups.forEach((group) => {
		const trigger = group.querySelector<HTMLButtonElement>(".nav-link--group");
		trigger?.addEventListener("click", (event) => {
			if (isMobile()) {
				event.stopPropagation();
				const open = group.classList.contains("nav-group--open");
				closeAllGroups(group);
				group.classList.toggle("nav-group--open", !open);
				trigger.setAttribute("aria-expanded", String(!open));
				return;
			}
			// Desktop mouse click: blur so :focus-within doesn't keep the dropdown
			// stuck open after the pointer leaves. event.detail is 0 for keyboard-
			// triggered clicks, so keyboard users keep focus (and the open dropdown).
			if (event.detail > 0) trigger.blur();
		});
	});

	document.addEventListener("click", () => {
		if (isMobile()) closeAllGroups();
	});

	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape") return;
		if (isMobile() && menu?.classList.contains("nav-menu--open")) {
			setMenuOpen(false);
			toggle?.focus();
		} else {
			closeAllGroups();
		}
	});

	// Crossing the breakpoint changes animated properties, which would otherwise
	// play the open/close transitions. Disable transitions for that switch, then
	// re-enable them two frames later, once the new styles have been applied.
	const header = document.querySelector<HTMLElement>(".vega-nav");
	let resizeFrame = 0;

	mobileQuery.addEventListener("change", (e) => {
		header?.classList.add("vega-nav--no-transition");
		if (!e.matches) setMenuOpen(false); // don't leave mobile state half-open

		cancelAnimationFrame(resizeFrame);
		resizeFrame = requestAnimationFrame(() => {
			resizeFrame = requestAnimationFrame(() => {
				header?.classList.remove("vega-nav--no-transition");
			});
		});
	});
</script>

<style lang="scss">
	.vega-nav {
		--nav-charcoal: var(--color-charcoal, #221e1a);
		--nav-muted: var(--color-text-muted, #6b6560);
		--nav-bg: var(--color-bg, #faf6ee);
		--nav-border: var(--color-border, #e4dccb);
		--nav-olive: var(--color-primary, #2e4a3b);
		--nav-height: 84px;
		--nav-ease-out: cubic-bezier(0.22, 1, 0.36, 1); // fast start, soft landing
		--nav-ease-in: cubic-bezier(0.4, 0, 1, 1);

		background: var(--nav-bg);
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--nav-border);

		.container {
			height: var(--nav-height);
			display: flex;
			align-items: center;
			gap: 1.5rem;
		}

		// Brand
		.nav-brand {
			text-decoration: none;
			flex-shrink: 0;
		}

		// Menu
		.nav-menu {
			display: flex;
			align-items: center;
			gap: 1.25rem;
			margin-left: auto;
		}

		.nav-links {
			display: flex;
			align-items: center;
			gap: 0;
			list-style: none;
			padding: 0;
			margin: 0;
		}

		.nav-link {
			display: block;
			padding: 0.85em 0.9em;
			font-size: 0.85rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--nav-muted);
			text-decoration: none;
			position: relative;
			white-space: nowrap;
			transition: color 0.2s ease;

			&::after {
				content: "";
				position: absolute;
				bottom: 0.15em;
				left: 0.9em;
				right: 0.9em;
				height: 1px;
				background: var(--color-accent, #7c2e28);
				transform: scaleX(0);
				transition: transform 0.25s ease;
				transform-origin: left;
			}

			&:hover {
				color: var(--nav-charcoal);
			}

			&.nav-link--active {
				color: var(--nav-charcoal);

				&::after {
					transform: scaleX(1);
				}
			}
		}

		// Group toggle is a <button>; reset its native styles
		.nav-link--group {
			display: inline-flex;
			align-items: center;
			gap: 0.35em;
			cursor: pointer;
			background: none;
			border: 0;
			font-family: inherit;
			line-height: inherit;
		}

		.nav-caret {
			flex-shrink: 0;
			transition: transform 0.2s ease;
		}

		// Dropdown groups
		.nav-group {
			position: relative;

			.nav-dropdown {
				position: absolute;
				top: 100%;
				left: 0;
				min-width: 210px;
				margin: 0;
				padding: 0.5rem 0;
				list-style: none;
				background: var(--nav-bg);
				border: 1px solid var(--nav-border);
				box-shadow: 0 8px 24px rgba(34, 30, 26, 0.08);
				opacity: 0;
				visibility: hidden;
				transform: translateY(4px);
				transition:
					opacity 0.18s ease,
					transform 0.18s ease,
					visibility 0.18s;
			}

			&.nav-group--open {
				.nav-dropdown {
					opacity: 1;
					visibility: visible;
					transform: translateY(0);
				}

				.nav-caret {
					transform: rotate(180deg);
				}
			}
		}

		@media (min-width: 1181px) {
			// Wrapper disappears from layout on desktop; children join .nav-menu's flex row
			.nav-menu__inner {
				display: contents;
			}

			// Hover (or keyboard focus) reveals the dropdown directly
			.nav-group:hover,
			.nav-group:focus-within {
				.nav-dropdown {
					opacity: 1;
					visibility: visible;
					transform: translateY(0);
				}

				.nav-caret {
					transform: rotate(180deg);
				}
			}
		}

		.nav-dropdown-link {
			display: block;
			padding: 0.85em 1.25rem;
			border-left: 3px solid transparent;
			font-size: 0.78rem;
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--nav-muted);
			text-decoration: none;
			white-space: nowrap;
			transition:
				color 0.2s ease,
				background 0.2s ease,
				border-color 0.2s ease;

			&:hover {
				color: var(--nav-charcoal);
				background: var(--nav-border);
			}

			&.nav-dropdown-link--active {
				color: var(--nav-charcoal);
				font-weight: 700;
				background: var(--nav-border);
				border-left-color: var(--color-accent, #7c2e28);
			}
		}

		// CTA button — editorial outlined style
		.nav-cta {
			flex-shrink: 0;
			display: inline-block;
			padding: 0.75em 1.5em;
			background: transparent;
			color: var(--nav-charcoal);
			font-size: 0.8rem;
			font-weight: 600;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			border: 1.5px solid var(--nav-charcoal);
			border-radius: 0;
			box-shadow: var(--shadow-hard);
			text-decoration: none;
			transition:
				background 0.2s ease,
				color 0.2s ease;

			&:hover {
				background: var(--nav-charcoal);
				color: var(--nav-bg);
			}

			&.nav-cta--solid {
				background: var(--nav-olive);
				color: var(--nav-bg);
				border-color: var(--nav-olive);

				&:hover {
					background: var(--nav-charcoal);
					border-color: var(--nav-charcoal);
					color: var(--nav-bg);
				}
			}
		}

		// Hamburger
		.nav-toggle {
			display: none;
			flex-direction: column;
			justify-content: center;
			gap: 5px;
			width: 32px;
			height: 32px;
			background: none;
			border: none;
			cursor: pointer;
			margin-left: auto;
			padding: 0;

			span {
				display: block;
				width: 100%;
				height: 2px;
				background: #0a4546;
				transform-origin: center;
				transition:
					transform 0.15s cubic-bezier(0.65, 0, 0.35, 1),
					opacity 0.2s ease,
					background 0.2s ease;

				&:nth-child(2) {
					filter: blur(0);
					transition:
						transform 0.2s ease,
						opacity 0.2s ease,
						filter 0.2s ease;
				}
			}

			&[aria-expanded="true"] span {
				background: #7b2e29;

				&:nth-child(1) {
					transform: translateY(7px) rotate(45deg);
					transition-delay: 0.1s;
				}

				&:nth-child(2) {
					opacity: 0;
					transform: translateY(-10px);
					filter: blur(2px);
					transition:
						transform 0.2s ease,
						opacity 0.2s ease,
						filter 0s ease;
				}

				&:nth-child(3) {
					transform: translateY(-7px) rotate(-45deg);
					transition-delay: 0.1s;
				}
			}
		}

		// Mobile
		@media (max-width: 1180px) {
			.nav-toggle {
				display: flex;
			}

			// Grid row animates 0fr -> 1fr, i.e. to the content's real height
			.nav-menu {
				position: absolute;
				top: var(--nav-height);
				left: 0;
				right: 0;
				margin-left: 0;
				background: var(--nav-bg);
				display: grid;
				grid-template-rows: 0fr;
				overflow: hidden; // clips the inner padding/border so it can't peek out at 0fr
				visibility: hidden;
				// Closing: quicker, then hide once collapsed
				transition:
					grid-template-rows 0.3s var(--nav-ease-in),
					visibility 0s linear 0.3s;

				&.nav-menu--open {
					grid-template-rows: 1fr;
					visibility: visible;
					// Opening: longer, decelerating
					transition:
						grid-template-rows 0.45s var(--nav-ease-out),
						visibility 0s linear 0s;
				}
			}

			.nav-menu__inner {
				min-height: 0; // lets the 0fr row actually shrink to zero
				max-height: calc(100dvh - var(--nav-height));
				overflow: hidden; // no scrollbar during the animation
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				padding: 1rem 1.5rem 1.5rem;
				border-bottom: 1px solid var(--nav-border);
				box-sizing: border-box;

				// Keep this on its own layer permanently; otherwise the layer is dropped
				// when the animation ends and the text re-renders a pixel off.
				will-change: opacity, transform;

				// Content fades and settles in, rather than just being uncovered
				opacity: 0;
				transform: translateY(-0.5rem);
				transition:
					opacity 0.2s var(--nav-ease-in),
					transform 0.3s var(--nav-ease-in);
			}

			.nav-menu--open .nav-menu__inner {
				opacity: 1;
				transform: none;
				transition:
					opacity 0.3s var(--nav-ease-out) 0.05s,
					transform 0.45s var(--nav-ease-out);
			}

			// Only allow scrolling once fully open (class added by the script)
			.nav-menu--open.nav-menu--settled .nav-menu__inner {
				overflow-y: auto;
			}

			.nav-links {
				flex-direction: column;
				align-items: flex-start;
				width: 100%;
				gap: 0;
			}

			.nav-link {
				padding: 1em 0;
				width: 100%;
				text-align: left;
				font-size: 0.9rem;

				&::after {
					left: 0;
					right: auto;
					width: 1.5em;
				}
			}

			.nav-link--group {
				justify-content: space-between;
			}

			// Same grid trick for each dropdown: row 1 is the button, row 2 the list
			.nav-group {
				width: 100%;
				display: grid;
				grid-template-rows: auto 0fr;
				transition: grid-template-rows 0.25s var(--nav-ease-in);

				&.nav-group--open {
					grid-template-rows: auto 1fr;
					transition: grid-template-rows 0.35s var(--nav-ease-out);
				}

				.nav-dropdown {
					position: static;
					min-height: 0;
					min-width: 0;
					width: 100%;
					overflow: hidden;
					border: none;
					box-shadow: none;
					padding: 0 0 0 1rem;
					background: transparent;
					will-change: opacity;
					opacity: 0;
					transform: none;
					visibility: hidden;
					transition:
						opacity 0.15s var(--nav-ease-in),
						visibility 0s linear 0.25s;
				}

				&.nav-group--open .nav-dropdown {
					opacity: 1;
					visibility: visible;
					transition:
						opacity 0.3s var(--nav-ease-out) 0.05s,
						visibility 0s linear 0s;
				}
			}

			.nav-dropdown-link {
				padding: 0.85em 0 0.85em 0.75rem;
				font-size: 0.85rem;

				&:hover {
					background: transparent;
				}

				&.nav-dropdown-link--active {
					background: transparent;
				}
			}

			.nav-cta {
				margin-top: 1rem;

				& + .nav-cta {
					margin-top: 0.75rem;
				}
			}
		}

		// Set briefly by the script while crossing the mobile breakpoint
		&.vega-nav--no-transition {
			&,
			*,
			*::before,
			*::after {
				transition: none !important;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			*,
			*::before,
			*::after {
				transition-duration: 0s !important;
				transition-delay: 0s !important;
			}
		}
	}
</style>