---
import DiamondRule from '@/components/ui/DiamondRule.astro';

type Pillar = {
	icon?: string;
	title: string;
	description: string;
	linkUrl?: string;
};

type Props = {
	tagline?: string;
	items: Pillar[];
};

const { tagline, items } = Astro.props;

const icons: Record<string, string> = {
	pantry: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="14" rx="1"/><path d="M3 11h18"/><path d="M8 3h8l1 4H7l1-4Z"/></svg>`,
	produce: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c-4.5 0-8-3.5-8-8 0-4 3-7 8-11 5 4 8 7 8 11 0 4.5-3.5 8-8 8Z"/><path d="M12 22V11"/></svg>`,
	mill: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v9l6 3"/></svg>`,
	'grab-and-go': `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>`,
};
---

<section class="vega-pillars section">
	<div class="container">
		{tagline && (
			<div class="pillars-tagline-block" data-animate="fade-up">
				<p class="pillars-tagline">{tagline}</p>
				<DiamondRule width={28} class="pillars-divider" />
			</div>
		)}

		<div class="pillars-grid">
			{items.map((item) => {
				const Tag = item.linkUrl ? 'a' : 'div';
				return (
					<Tag class="pillar-card" href={item.linkUrl || undefined} data-animate="fade-up-sm" data-animate-stagger="0.1">
						{item.icon && icons[item.icon] && (
							<span class="pillar-icon" set:html={icons[item.icon]} />
						)}
						<h3 class="pillar-title">{item.title}</h3>
						<p class="pillar-description">{item.description}</p>
					</Tag>
				);
			})}
		</div>
	</div>
</section>

<style>
	.pillars-tagline-block {
		max-width: 640px;
		margin: 0 auto 2.75rem;
		text-align: center;
	}

	.pillars-tagline {
		font-family: var(--font-secondary), sans-serif;
		font-size: clamp(1.1rem, 2.2vw, 1.35rem);
		color: var(--color-primary-dark);
		line-height: 1.6;
		margin-bottom: 1.25rem;
	}

	:global(.pillars-divider) {
		margin: 0 auto;
	}

	.pillars-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}
	@media (min-width: 900px) {
		.pillars-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.pillar-card {
		display: block;
		background: var(--color-bg);
		border: 2px dashed var(--color-border-dashed);
		border-radius: var(--radius-dashed);
		padding: 1.75rem 1.5rem;
		text-decoration: none;
		transition: border-color 0.25s ease, transform 0.25s ease;
	}
	a.pillar-card:hover {
		border-color: var(--color-accent);
		transform: translateY(-3px);
	}

	.pillar-icon {
		display: inline-flex;
		color: var(--color-primary);
		margin-bottom: 0.85rem;
	}
	.pillar-icon :global(svg) {
		width: 1.75rem;
		height: 1.75rem;
	}

	.pillar-title {
		font-size: 1rem;
		margin-bottom: 0.5rem;
	}
	.pillar-title::before {
		content: '';
		display: inline-block;
		width: 5px;
		height: 5px;
		background: var(--color-accent);
		transform: rotate(45deg);
		margin-right: 0.5em;
		vertical-align: 0.12em;
	}

	.pillar-description {
		font-size: 0.88rem;
		color: var(--color-text-muted);
		line-height: 1.65;
		margin: 0;
	}
</style>
