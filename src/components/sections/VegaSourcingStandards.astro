---
import Img from '@/components/ui/Img.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import placeholderImg from '@/assets/images/placeholder.png';
import type { ImageMetadata } from 'astro';

export type SourcingItem = {
	title: string;
	description: string;
};

type Props = {
	title?: string;
	watermarkText?: string;
	body?: string;
	icon?: string;
	image?: {
		src: ImageMetadata | string;
		alt: string;
		caption?: string;
	};
	items: SourcingItem[];
};

const {
	title = 'Our sourcing standards',
	watermarkText,
	body,
	icon,
	image,
	items,
} = Astro.props;

const defaultIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`;

const resolvedIcon = icon ?? defaultIcon;
---

<section class="sourcing">
	<div class="container">
		<div class="sourcing__grid">

			<!-- Left column -->
			<div class="sourcing__left">
				{watermarkText && (
					<span class="sourcing__watermark" aria-hidden="true">{watermarkText}</span>
				)}

				<div class="sourcing__header">
					<SectionHeader title={title} align="left" />
				</div>

				{body && <p class="sourcing__body">{body}</p>}

				{image && (
					<div class="sourcing__photo-frame">
						<div class="sourcing__photo-inner">
							<Img
								src={image.src || placeholderImg}
								alt={image.alt}
								width={360}
								height={280}
								class="sourcing__photo-img"
							/>
						</div>
						{image.caption && (
							<p class="sourcing__caption">{image.caption}</p>
						)}
					</div>
				)}
			</div>

			<!-- Right column: numbered list -->
			<div class="sourcing__right">
				<ol class="sourcing__list">
					{items.map((item, i) => (
						<li class="sourcing__item">
							<span class="sourcing__num">
								{String(i + 1).padStart(2, '0')}.
							</span>
							<div class="sourcing__item-body">
								<h3 class="sourcing__item-title">{item.title}</h3>
								<p class="sourcing__item-desc">{item.description}</p>
							</div>
						</li>
					))}
				</ol>
			</div>

		</div>
	</div>
</section>

<style>
	.sourcing {
		background: #F7F4F0;
		padding: 5rem 0 4rem;
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	/* ── Two-column grid ─────────────────────────────────────── */
	.sourcing__grid {
		display: grid;
		grid-template-columns: 2fr 3fr;
		gap: 4rem;
		align-items: start;
	}

	@media (max-width: 768px) {
		.sourcing__grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	/* ── Left column ─────────────────────────────────────────── */
	.sourcing__left {
		position: relative;
	}

	.sourcing__watermark {
		position: absolute;
		top: -0.25em;
		left: -0.1em;
		font-family: var(--font-primary), Georgia, serif;
		font-size: clamp(4rem, 10vw, 7rem);
		font-weight: 800;
		line-height: 1;
		color: rgba(45, 58, 92, 0.055);
		pointer-events: none;
		user-select: none;
		white-space: nowrap;
		z-index: 0;
	}

	.sourcing__header {
		position: relative;
		z-index: 1;
	}

	/* ── Body text ───────────────────────────────────────────── */
	.sourcing__body {
		font-size: 0.95rem;
		line-height: 1.75;
		color: #6B7A8D;
		margin-bottom: 2rem;
		max-width: 36ch;
	}

	@media (max-width: 768px) {
		.sourcing__body {
			max-width: none;
		}
	}

	/* ── Photo card ──────────────────────────────────────────── */
	.sourcing__photo-frame {
		display: inline-block;
		background: #fff;
		padding: 0.75rem 0.75rem 1.25rem;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1), 0 8px 24px rgba(0, 0, 0, 0.07);
		transform: rotate(2deg);
		max-width: 280px;
		margin-top: 0.5rem;
	}

	@media (max-width: 768px) {
		.sourcing__photo-frame {
			display: block;
			max-width: 100%;
			transform: none;
		}
	}

	.sourcing__photo-inner {
		overflow: hidden;
	}

	.sourcing__photo-inner :global(.ui-image-container) {
		width: 100%;
		aspect-ratio: 4 / 3;
	}

	.sourcing__photo-inner :global(.ui-image) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.sourcing__caption {
		font-family: Georgia, 'Times New Roman', serif;
		font-style: italic;
		font-size: 0.85rem;
		color: #6B7A8D;
		margin-top: 0.6rem;
		text-align: center;
	}

	/* ── Right column: numbered list ─────────────────────────── */
	.sourcing__list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.sourcing__item {
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: 1rem;
		align-items: start;
		padding: 2rem 0;
		border-bottom: 1px solid #E0D8D0;
	}

	.sourcing__item:first-child {
		padding-top: 0.5rem;
	}

	.sourcing__item:last-child {
		border-bottom: none;
	}

	.sourcing__num {
		font-size: 0.85rem;
		font-weight: 600;
		color: #A0ADB8;
		letter-spacing: 0.04em;
		padding-top: 0.2rem;
		flex-shrink: 0;
	}

	.sourcing__item-title {
		font-family: var(--font-primary), Georgia, serif;
		font-size: 1.15rem;
		font-weight: 600;
		color: #6B8F80;
		margin-bottom: 0.6rem;
		line-height: 1.3;
	}

	.sourcing__item-desc {
		font-size: 0.92rem;
		line-height: 1.75;
		color: #6B7A8D;
		margin: 0;
	}
</style>
