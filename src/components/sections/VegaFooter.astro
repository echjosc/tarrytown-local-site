---
import type { ImageMetadata } from 'astro';
import Brandmark from '@/components/ui/Brandmark.astro';

type NavLink = { label: string; url: string };
type NavColumn = { heading: string; links: NavLink[] };
type Social = { platform: "instagram" | "pinterest" | "facebook" | "tiktok" | "twitter"; url: string };

type Props = {
	logoSrc?: ImageMetadata | string;
	logoAlt?: string;
	tagline?: string;
	columns?: NavColumn[];
	socials?: Social[];
};

const {
	logoSrc,
	logoAlt = "Logo",
	tagline,
	columns = [],
	socials = [],
} = Astro.props;

const socialIcons: Record<string, string> = {
	instagram: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/></svg>`,
	pinterest: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>`,
	facebook: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.268h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>`,
	tiktok: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.79 1.54V6.78a4.85 4.85 0 0 1-1.02-.09z"/></svg>`,
	twitter: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
};
---

<footer class="vega-footer">
	<div class="footer-main">
		<div class="container">
			<!-- Brand column -->
			<div class="brand-col">
				<a href="/" class="footer-logo">
					<Brandmark logoSrc={logoSrc} logoAlt={logoAlt} size="large" />
				</a>
				{tagline && <p class="footer-tagline">{tagline}</p>}
				{socials.length > 0 && (
					<div class="social-links">
						{socials.map((s) => (
							<a
								href={s.url}
								class="social-link"
								target="_blank"
								rel="noopener noreferrer"
								aria-label={s.platform}
								set:html={socialIcons[s.platform]}
							/>
						))}
					</div>
				)}
			</div>

			<!-- Nav columns -->
			{columns.map((col) => (
				<div class="nav-col">
					<p class="nav-heading">
						{col.heading}
					</p>
					<ul class="nav-list">
						{col.links.map((link) => (
							<li>
								<a href={link.url} class="nav-link">{link.label}</a>
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</div>

	<div class="footer-bottom">
		<div class="container">
			<p class="copyright">
				&copy; {new Date().getFullYear()} Tarrytown Local. All rights reserved. <a href="https://josephecheverria.com" target="_blank" rel="noopener noreferrer">Website by Joe</a>.
			</p>
		</div>
	</div>
</footer>

<style lang="scss">
	.vega-footer {
		--footer-navy: var(--color-charcoal, #221E1A);
		--footer-muted: var(--color-text-muted, #6B6560);
		--footer-rule: var(--color-border, #E4DCCB);
		--footer-bg: var(--color-bg-muted, #F1EADD);
		--footer-bottom-bg: var(--color-border-light, #EFE8DA);

		background: var(--footer-bg);

		// Main area
		.footer-main {
			padding: 4rem 0 3rem;

			.container {
				display: grid;
				grid-template-columns: 1.4fr repeat(var(--col-count, 3), 1fr);
				gap: 2.5rem;

				@media (max-width: 700px) {
					grid-template-columns: 1fr 1fr;
				}

				@media (max-width: 420px) {
					grid-template-columns: 1fr;
				}
			}
		}

		// Brand column
		.brand-col {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.footer-logo {
			display: inline-block;

			:global(.brandmark) {
				align-items: flex-start;
				text-align: left;
			}
			:global(.brandmark__divider) {
				display: none;
			}
		}

		.footer-tagline {
			font-size: 0.9rem;
			color: var(--footer-muted);
			line-height: 1.65;
			max-width: 220px;
			margin: 0;
		}

		.social-links {
			display: flex;
			gap: 0.75rem;
			margin-top: 0.25rem;
		}

		.social-link {
			display: flex;
			align-items: center;
			justify-content: center;
			color: var(--footer-muted);
			transition: color 0.2s ease;

			&:hover {
				color: var(--footer-navy);
			}
		}

		// Nav columns
		.nav-col {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}

		.nav-heading {
			display: flex;
			align-items: center;
			gap: 0.5em;
			font-size: 0.65rem;
			font-weight: 700;
			letter-spacing: 0.2em;
			text-transform: uppercase;
			color: var(--footer-navy);
			margin: 0;
			font-family: var(--font-primary);
		}
		.nav-heading::before {
			content: '';
			display: block;
			width: 5px;
			height: 5px;
			background: var(--color-accent, #7C2E28);
			transform: rotate(45deg);
			flex-shrink: 0;
		}

		.nav-list {
			list-style: none;
			padding: 0;
			margin: 0;
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
		}

		.nav-link {
			font-size: 0.9rem;
			color: var(--footer-muted);
			text-decoration: none;
			transition: color 0.2s ease;

			&:hover {
				color: var(--footer-navy);
			}
		}

		// Bottom bar
		.footer-bottom {
			background: var(--footer-bottom-bg);
			border-top: 1px solid var(--footer-rule);
			padding: 1.25rem 0;

			.container {
				display: flex;
				align-items: center;
				justify-content: space-between;
			}
		}

		.copyright {
			font-size: 0.8rem;
			color: var(--footer-muted);
			margin: 0;

			a {
				color: var(--footer-muted);
				transition: color 0.2s ease;
				
				&:hover {
					text-decoration: underline;
					color: var(--footer-navy);
				}
			}
		}
	}
</style>
