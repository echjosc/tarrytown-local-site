---
export type PhilosophyItem = {
	title: string;
	description: string;
};

type Props = {
	quote?: string;
	items?: PhilosophyItem[];
	ctaText?: string;
	ctaUrl?: string;
};

const {
	quote,
	items = [],
	ctaText = 'Explore Our Story',
	ctaUrl = '/our-story',
} = Astro.props;

const leafIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`;
---

<section class="philosophy">
	<div class="container philosophy-inner">

		{quote && (
			<div class="philosophy__header" data-animate="fade-up">
				<span class="philosophy__icon" set:html={leafIcon} />
				<blockquote class="philosophy__quote">"{quote}"</blockquote>
			</div>
		)}

		{items.length > 0 && (
			<div class="philosophy__grid" style={`--item-count: ${items.length}`}>
				{items.map((item) => (
					<div class="philosophy__item" data-animate="fade-up-sm" data-animate-stagger="0.1">
						<h3 class="philosophy__item-title">{item.title}</h3>
						<p class="philosophy__item-desc">{item.description}</p>
					</div>
				))}
			</div>
		)}

		{ctaText && (
			<div class="philosophy__cta" data-animate="fade-up-sm">
				<a href={ctaUrl} class="philosophy__btn">{ctaText}</a>
			</div>
		)}

	</div>
</section>


<style>
	.philosophy {
		background: var(--color-bg-muted, #F1EADD);
		padding: 5.5rem 0;
		border-top: 1px solid var(--color-border, #E4DCCB);
		border-bottom: 1px solid var(--color-border, #E4DCCB);
	}

	.philosophy-inner {
		max-width: 900px;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3.5rem;
	}

	/* ── Header / Quote ──────────────────────────────────── */
	.philosophy__header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		text-align: center;
	}

	.philosophy__icon {
		display: flex;
		align-items: center;
		color: var(--color-primary, #2E4A3B);
	}

	.philosophy__icon :global(svg) {
		width: 28px;
		height: 28px;
	}

	.philosophy__quote {
		font-family: var(--font-secondary), sans-serif;
		font-size: clamp(1.5rem, 3.2vw, 2.1rem);
		font-weight: 500;
		letter-spacing: 0;
		color: var(--color-charcoal, #221E1A);
		line-height: 1.45;
		margin: 0;
		max-width: 760px;
	}

	/* ── 3-col grid ─────────────────────────────────────── */
	.philosophy__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 2.5rem 3rem;
		width: 100%;
	}

	.philosophy__item {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.philosophy__item-title {
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-text-light, #9A9186);
		margin: 0;
	}

	.philosophy__item-desc {
		font-size: 0.92rem;
		line-height: 1.75;
		color: var(--color-text-muted, #6B6560);
		margin: 0;
	}

	/* ── CTA ─────────────────────────────────────────────── */
	.philosophy__cta {
		display: flex;
		justify-content: center;
	}

	.philosophy__btn {
		display: inline-block;
		padding: 0.75rem 2rem;
		background: var(--color-charcoal, #221E1A);
		color: var(--color-bg, #FAF6EE);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		text-decoration: none;
		border-radius: 0;
		border: 1.5px solid var(--color-charcoal, #221E1A);
		box-shadow: var(--shadow-hard);
		transition: background 0.2s ease, color 0.2s ease;
	}

	.philosophy__btn:hover {
		background: var(--color-primary, #2E4A3B);
		border-color: var(--color-primary, #2E4A3B);
	}

	@media (max-width: 600px) {
		.philosophy__grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

</style>
