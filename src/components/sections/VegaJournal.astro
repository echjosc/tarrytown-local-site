---
import PageHero from '@/components/ui/PageHero.astro';
import Tag from '@/components/ui/Tag.astro';
import { Image } from 'astro:assets';
import { resolveImage } from '@/utils/resolveImage';

type Post = {
	id: string;
	data: {
		title: string;
		excerpt?: string;
		date?: Date | string;
		author?: string;
		featuredImage?: string;
		tags?: string[];
		draft?: boolean;
	};
};

type Props = {
	posts: Post[];
	eyebrow?: string;
	title?: string;
	subtitle?: string;
};

const {
	posts,
	eyebrow = 'The Blog',
	title = 'The Good Dirt',
	subtitle = 'Stories from the Hudson Valley',
} = Astro.props;

function formatDate(dateStr?: Date | string) {
	if (!dateStr) return '';
	return new Date(dateStr).toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}

const categories = [
	{
		label: 'Regenerative Farming',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>`,
	},
	{
		label: 'Seasonal Recipes',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7"/></svg>`,
	},
	{
		label: 'Field Notes',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>`,
	},
	{
		label: 'Community',
		icon: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
	},
];
---

<div class="journal-page">
	<!-- Page hero -->
	<PageHero {eyebrow} {title} {subtitle} {categories} />

	<!-- Post grid -->
	<div class="journal-main container">
		{posts.length === 0 ? (
			<div class="journal-empty">
				<p>No posts yet. <a href="/keystatic">Add your first post →</a></p>
			</div>
		) : (
			<div class="journal-grid">
				{posts.map((post) => (
					<a href={`/blog/${post.id}`} class="post-card" data-animate="fade-up" data-animate-stagger="0.09">
						{post.data.featuredImage && (() => {
							const img = resolveImage(post.data.featuredImage);
							return (
								<div class="post-card__image">
									{img
										? <Image src={img} alt={post.data.title} />
										: <img src={post.data.featuredImage} alt={post.data.title} loading="lazy" />
									}
								</div>
							);
						})()}
						<div class="post-card__body">
							{post.data.tags && post.data.tags.length > 0 && (
								<div class="post-card__tags">
									{post.data.tags.map((tag) => (
										<Tag label={tag} />
									))}
								</div>
							)}
							<h2 class="post-card__title">{post.data.title}</h2>
							{post.data.excerpt && (
								<p class="post-card__excerpt">{post.data.excerpt}</p>
							)}
							<div class="post-card__meta">
								{post.data.author && (
									<span class="post-card__author">{post.data.author}</span>
								)}
								{post.data.date && (
									<>
										<span class="post-card__dot" aria-hidden="true">•</span>
										<time datetime={(post.data.date instanceof Date ? post.data.date : new Date(post.data.date)).toISOString()}>
											{formatDate(post.data.date)}
										</time>
									</>
								)}
							</div>
						</div>
						{post.data.draft && (
							<span class="post-card__draft">Draft</span>
						)}
					</a>
				))}
			</div>
		)}
	</div>
</div>

<style>
	.journal-page {
		min-height: 90vh;
		display: flex;
		flex-direction: column;
	}

	/* ── Grid ────────────────────────────────────────────────── */
	.journal-main {
		padding-top: 3rem;
		padding-bottom: 5rem;
	}

	.journal-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 2rem;
	}

	@media (min-width: 640px) {
		.journal-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* ── Post card ───────────────────────────────────────────── */
	.post-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
		background: var(--color-bg, #FAF6EE);
		border: 2px dashed var(--color-border-dashed, #6B9C86);
		border-radius: var(--radius-dashed, 20px);
		overflow: hidden;
		transition: border-color 0.25s ease, transform 0.25s ease;
		position: relative;
	}

	.post-card:hover {
		border-color: var(--color-accent, #7C2E28);
		transform: translateY(-2px);
	}

	.post-card__image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: var(--color-bg-muted, #F1EADD);
	}

	.post-card__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}

	.post-card:hover .post-card__image img {
		transform: scale(1.04);
	}

	.post-card__body {
		padding: 1.5rem 1.75rem 1.75rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.post-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 0.75rem;
	}

	.post-card__title {
		font-family: var(--font-primary), sans-serif;
		font-size: 1.1rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		line-height: 1.35;
		color: var(--color-charcoal, #221E1A);
		margin-bottom: 0.6rem;
	}

	.post-card__excerpt {
		font-size: 0.9rem;
		color: var(--color-text-muted, #6B6560);
		line-height: 1.65;
		flex: 1;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-card__meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 1.25rem;
		font-size: 0.8rem;
		color: var(--color-text-light, #9A9186);
	}

	.post-card__author {
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		font-size: 0.75rem;
	}

	.post-card__dot {
		font-size: 0.6rem;
		opacity: 0.6;
	}

	.post-card__draft {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		font-size: 0.65rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		background: rgba(251, 191, 36, 0.15);
		color: #b45309;
		border: 1px solid rgba(251, 191, 36, 0.3);
	}

	/* ── Empty state ─────────────────────────────────────────── */
	.journal-empty {
		text-align: center;
		padding: 4rem 0;
		color: var(--color-text-light, #9A9186);
	}

	.journal-empty a {
		color: var(--color-charcoal, #221E1A);
		font-weight: 700;
	}
</style>
