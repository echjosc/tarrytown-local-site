---
import Img from "@/components/ui/Img.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";
import type { ImageMetadata } from 'astro';

type OfferingCard = {
	eyebrow?: string;
	title: string;
	description: string;
	imageSrc?: ImageMetadata | string;
	imageAlt?: string;
	icon?: string;
	linkText?: string;
	linkUrl?: string;
};

type Props = {
	sectionTitle?: string;
	featured: OfferingCard;
	cards: [OfferingCard, OfferingCard];
};

const { sectionTitle = "Our Offerings", featured, cards } = Astro.props;
---

<section class="vega-offerings">
	<div class="container">
		{sectionTitle && <SectionHeader title={sectionTitle} />}

		<div class="offerings-grid">
			<!-- Featured card (left, large) -->
			<div class="offering-card offering-card--featured">
				{featured.imageSrc && (
					<div class="card-image">
						<Img
							src={featured.imageSrc}
							alt={featured.imageAlt ?? featured.title}
							width={740}
							height={460}
							class="card-img"
							loading="eager"
						/>
					</div>
				)}
				<div class="card-body">
					{featured.eyebrow && (
						<p class="card-eyebrow">{featured.eyebrow}</p>
					)}
					<h3 class="card-title">{featured.title}</h3>
					<p class="card-description">{featured.description}</p>
					{featured.linkText && featured.linkUrl && (
						<a href={featured.linkUrl} class="card-link">
							{featured.linkText}
							<span class="card-link-arrow" aria-hidden="true">→</span>
						</a>
					)}
				</div>
			</div>

			<!-- Two stacked cards (right) -->
			<div class="offerings-stack">
				{cards.map((card) => (
					<div class="offering-card offering-card--compact">
						{card.icon && (
							<div class="card-icon" set:html={card.icon} />
						)}
						<h3 class="card-title">{card.title}</h3>
						<p class="card-description">{card.description}</p>
						{card.linkText && card.linkUrl && (
							<a href={card.linkUrl} class="card-link">
								{card.linkText}
								<span class="card-link-arrow" aria-hidden="true">→</span>
							</a>
						)}
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	.vega-offerings {
		--offerings-navy: #2D3A5C;
		--offerings-muted: #6B7A8D;
		--offerings-bg-card: #F5F2EE;
		--offerings-rule: #C9A882;
		--offerings-icon-green: #6B8F80;
		--offerings-icon-rose: #C9857A;

		padding: 5rem 0 4rem;

		.container {
			max-width: 1100px;
			margin: 0 auto;
			padding: 0 1.5rem;
		}

		// Grid layout
		.offerings-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem;
			align-items: stretch;

			@media (max-width: 700px) {
				grid-template-columns: 1fr;
			}
		}

		// Shared card base
		.offering-card {
			background: var(--offerings-bg-card);
			border-radius: var(--radius);
			overflow: hidden;
		}

		// Featured card
		.offering-card--featured {
			display: flex;
			flex-direction: column;

			.card-image {
				width: 100%;
				overflow: hidden;
				border-radius: var(--radius) 4px 0 0;
				flex-shrink: 0;

				:global(.ui-image-container) {
					width: 100%;
					aspect-ratio: 16 / 10;
				}

				:global(.ui-image) {
					width: 100%;
					height: 100%;
					object-fit: cover;
					display: block;
				}
			}

			.card-body {
				padding: 1.75rem 2rem 2rem;
				flex: 1;
				display: flex;
				flex-direction: column;
			}
		}

		// Stack of compact cards
		.offerings-stack {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
		}

		.offering-card--compact {
			padding: 2rem;
			flex: 1;
			display: flex;
			flex-direction: column;
		}

		// Card icon
		.card-icon {
			margin-bottom: 1rem;
			font-size: 2rem;
			line-height: 1;

			:global(svg) {
				width: 2rem;
				height: 2rem;
			}
		}

		// Card text
		.card-eyebrow {
			font-size: 0.7rem;
			font-weight: 600;
			letter-spacing: 0.14em;
			text-transform: uppercase;
			color: var(--offerings-muted);
			margin-bottom: 0.5rem;
		}

		.card-title {
			font-size: 1.35rem;
			font-weight: 700;
			color: var(--offerings-navy);
			margin-bottom: 0.75rem;
		}

		.card-description {
			font-size: 0.95rem;
			color: var(--offerings-muted);
			line-height: 1.65;
			flex: 1;
		}

		.card-link {
			display: inline-flex;
			align-items: center;
			gap: 0.4em;
			margin-top: 1.25rem;
			font-size: 0.9rem;
			font-weight: 500;
			color: var(--offerings-navy);
			text-decoration: none;
			transition: gap 0.2s ease;

			&:hover {
				gap: 0.7em;
			}
		}

		.card-link-arrow {
			font-size: 1.1em;
		}
	}
</style>
