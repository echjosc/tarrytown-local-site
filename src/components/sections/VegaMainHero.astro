---
import Button from "@/components/ui/Button.astro";
import Img from "@/components/ui/Img.astro";
import placeholderImg from "@/assets/images/placeholder.png";
import type { ImageMetadata } from 'astro';

type Props = {
	eyebrow?: string;
	title: string;
	description?: string;
	imageSrc?: ImageMetadata | string;
	buttons?: { text: string; url: string }[];
	/** Renders each word of the title separated by a ◆, e.g. "EAT ◆ GOOD ◆ FOOD" */
	diamondTitle?: boolean;
	/** 'split' (default): text + framed image side-by-side. 'background': full-width background image with overlay. 'none': text-only, centered, no image. */
	variant?: 'split' | 'background' | 'none';
	/** Only affects the 'background' variant. 'full' (default): tall homepage-style hero. 'compact': shorter banner for interior pages. */
	size?: 'full' | 'compact';
	/** 'default': small uppercase kicker (used for page labels like "Restaurant"). 'badge': larger, boxed callout — use for announcements that need to stand out, like a pre-opening notice. */
	eyebrowVariant?: 'default' | 'badge';
};

const { eyebrow, title, description, imageSrc, buttons, diamondTitle = false, variant = 'split', size = 'full', eyebrowVariant = 'default' } = Astro.props;

const titleLines = title.split('\n');
---

<section class:list={['vega-main-hero', `vega-main-hero--${variant}`, variant === 'background' && `vega-main-hero--${size}`]}>
	{variant === 'background' && (
		<div class="hero-bg">
			<Img src={imageSrc || placeholderImg} alt="" class="hero-bg-img" width={1920} height={1080} loading="eager" fetchpriority="high" />
			<div class="hero-bg-overlay" />
		</div>
	)}
	<div class="container">
		<div class="text-content">
			{eyebrow && <p class:list={['hero-eyebrow', eyebrowVariant === 'badge' && 'hero-eyebrow--badge']}>{eyebrow}</p>}
			<h1 class="vega-main-hero-title">
				{diamondTitle
					? titleLines.map((line, lineIndex) => {
							const words = line.split(" ");
							return (
								<Fragment>
									{lineIndex > 0 && <br />}
									{words.map((word, i) => (
										<Fragment>
											{word}
											{i < words.length - 1 && <span class="title-diamond" aria-hidden="true" />}
										</Fragment>
									))}
								</Fragment>
							);
						})
					: titleLines.map((line, lineIndex) => {
							const lineParts = line.split(/(\{.*?\})/);
							return (
								<Fragment>
									{lineIndex > 0 && <br />}
									{lineParts.map((part) =>
										part.startsWith("{") ? (
											<span class="script">{part.slice(1, -1)}</span>
										) : (
											<Fragment>{part}</Fragment>
										),
									)}
								</Fragment>
							);
						})
				}
			</h1>
			{
				description && (
					<p class="vega-main-hero-description">{description}</p>
				)
			}
			{
				buttons && (
					<div class="button-group">
						{buttons.map((button, index) => (
							<Button href={button.url} variant={index === 0 ? 'primary' : 'secondary'}>
								{button.text}
							</Button>
						))}
					</div>
				)
			}
		</div>
		{variant === 'split' && (
			<div class="image-content">
				<div class="image-frame">
					<Img src={imageSrc || placeholderImg} alt="Vega Main Hero Image" class="image-img" width={800} height={900} loading="eager" fetchpriority="high" />
				</div>
			</div>
		)}
	</div>
</section>

<script>
	import gsap from "gsap";
	import { prefersReducedMotion } from "@/lib/utils/animations";

	if (!prefersReducedMotion()) {
		const hero = document.querySelector(".vega-main-hero");
		if (hero) {
			const eyebrow = hero.querySelector(".hero-eyebrow");
			const title = hero.querySelector(".vega-main-hero-title");
			const desc = hero.querySelector(".vega-main-hero-description");
			const buttons = hero.querySelector(".button-group");
			const image = hero.querySelector(".image-content, .hero-bg");

			const from = { opacity: 0, y: 24 };
			const fromImg = { opacity: 0, y: 32 };
			const ease = "power3.out";

			const tl = gsap.timeline();
			if (eyebrow) tl.fromTo(eyebrow, from, { opacity: 1, y: 0, duration: 0.55, ease }, 0.1);
			tl.fromTo(title, from, { opacity: 1, y: 0, duration: 0.65, ease }, 0.25);
			if (image) tl.fromTo(image, fromImg, { opacity: 1, y: 0, duration: 0.75, ease }, 0.35);
			if (desc) tl.fromTo(desc, from, { opacity: 1, y: 0, duration: 0.55, ease }, 0.45);
			if (buttons) tl.fromTo(buttons, from, { opacity: 1, y: 0, duration: 0.55, ease }, 0.6);
		}
	}
</script>

<style lang="scss">
	.vega-main-hero {
		--hero-charcoal: var(--color-charcoal, #221E1A);
		--hero-muted:    var(--color-text-muted, #6B6560);
		--hero-olive:    var(--color-primary, #2E4A3B);
		--hero-amber:    var(--color-accent, #7C2E28);
		--hero-cream:    var(--color-bg, #FAF6EE);

		padding: 5rem 0 4.5rem;
		border-bottom: 1px solid var(--color-border, #E4DCCB);

		.container {
			display: flex;
			flex-wrap: wrap;
			gap: 3.5rem;
			align-items: center;
		}

		.text-content {
			flex: 1 1 0;
			min-width: 280px;
		}

		.image-content {
			flex: 1 1 0;
			min-width: 280px;
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 1.5rem;
		}

		.image-frame {
			position: relative;
			border: 1.5px solid var(--hero-charcoal);
			box-shadow: var(--shadow-hard);
			border-radius: 0;
			max-width: 460px;
			width: 100%;
			box-sizing: border-box;

			:global(.image-img) {
				border-radius: 0;
				width: 100%;
				height: 100%;
				aspect-ratio: 6 / 5;
			}
		}

		.hero-eyebrow {
			font-size: 0.65rem;
			font-weight: 600;
			letter-spacing: 0.22em;
			text-transform: uppercase;
			color: var(--hero-muted);
			margin-bottom: 1rem;

			&--badge {
				font-size: 1.05rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				margin-bottom: 1.25rem;
			}
		}

		.vega-main-hero-title {
			font-size: clamp(2.4rem, 5vw, 3.5rem);
			font-weight: 800;
			line-height: 1.12;
			color: var(--hero-charcoal);
			margin-bottom: 1.25rem;
			text-transform: uppercase;
			letter-spacing: 0.02em;

			.script {
				font-family: var(--font-primary), sans-serif;
				font-weight: 500;
				text-transform: uppercase;
				color: var(--hero-olive);
				white-space: nowrap;
			}

			.title-diamond {
				display: inline-block;
				width: 0.22em;
				height: 0.22em;
				background: var(--hero-amber);
				transform: rotate(45deg);
				margin-inline: 0.32em;
				vertical-align: 0.3em;
			}
		}

		.vega-main-hero-subtitle {
			font-size: 0.9rem;
			font-family: var(--font-secondary), sans-serif;
			color: var(--hero-muted);
			margin-bottom: 1.25rem;
			letter-spacing: 0.02em;
		}

		.vega-main-hero-description {
			font-size: 0.95rem;
			color: var(--hero-muted);
			max-width: 460px;
			line-height: 1.75;
			margin-bottom: 0;
		}

		.button-group {
			display: flex;
			gap: 0.85rem;
			margin-top: 2.25rem;
			flex-wrap: wrap;

			:global(.ui-button) {
				background-color: var(--hero-charcoal);
				color: var(--hero-cream);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				padding: 0.75em 1.75em;
				border-radius: 0;
				border: 1.5px solid var(--hero-charcoal);
				transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;

				&:hover {
					background-color: var(--hero-olive);
					border-color: var(--hero-olive);
					color: var(--hero-cream);
				}
			}

			:global(.ui-button--secondary) {
				background-color: transparent;
				color: var(--hero-charcoal);
				border: 1.5px solid var(--hero-charcoal);

				&:hover {
					background-color: var(--hero-charcoal);
					color: var(--hero-cream);
				}
			}
		}

		// ── Background variant: full-bleed image, text overlaid ──
		&.vega-main-hero--background {
			position: relative;
			width: 100%;
			min-height: 80vh;
			padding: 0;
			border-bottom: none;
			display: flex;
			align-items: flex-end;
			overflow: hidden;

			.hero-bg {
				position: absolute;
				inset: 0;
				z-index: 0;

				:global(.hero-bg-img) {
					width: 100%;
					height: 100%;
					object-fit: cover;
				}

				.hero-bg-overlay {
					position: absolute;
					inset: 0;
					background: linear-gradient(180deg, rgba(34, 30, 26, 0.35) 0%, rgba(34, 30, 26, 0.35) 40%, rgba(34, 30, 26, 0.85) 100%);
				}
			}

			.container {
				position: relative;
				z-index: 1;
				display: block;
				padding-block: 4.5rem 4rem;
			}

			.text-content {
				max-width: 640px;
			}

			.hero-eyebrow {
				color: rgba(250, 246, 238, 0.75);

				&--badge {
					color: var(--hero-cream);
				}
			}

			.vega-main-hero-title {
				color: var(--hero-cream);

				.script {
					color: var(--hero-amber);
				}
			}

			.vega-main-hero-description {
				color: rgba(250, 246, 238, 0.85);
				max-width: 520px;
			}

			.button-group {
				:global(.ui-button) {
					background-color: var(--hero-cream);
					color: var(--hero-charcoal);
					border-color: var(--hero-cream);

					&:hover {
						background-color: var(--hero-olive);
						border-color: var(--hero-olive);
						color: var(--hero-cream);
					}
				}

				:global(.ui-button--secondary) {
					background-color: transparent;
					color: var(--hero-cream);
					border-color: var(--hero-cream);

					&:hover {
						background-color: var(--hero-cream);
						border-color: var(--hero-cream);
						color: var(--hero-charcoal);
					}
				}
			}

			@media (max-width: 640px) {
				min-height: 70vh;

				.container {
					padding-block: 3rem 2.5rem;
				}
			}

			&.vega-main-hero--compact {
				min-height: 45vh;

				.container {
					padding-block: 3rem 2.5rem;
				}

				@media (max-width: 640px) {
					min-height: 340px;
				}
			}
		}

		// ── None variant: text-only, centered, no image ──
		&.vega-main-hero--none {
			.container {
				display: block;
				text-align: center;
			}

			.text-content {
				max-width: 640px;
				margin-inline: auto;
			}

			.button-group {
				justify-content: center;
			}

			.vega-main-hero-description {
				margin-inline: auto;
			}
		}
	}

	// Pre-animation states
	:global(.js) .hero-eyebrow,
	:global(.js) .vega-main-hero-title,
	:global(.js) .vega-main-hero-description,
	:global(.js) .button-group {
		opacity: 0;
		transform: translateY(24px);
	}

	:global(.js) .image-content,
	:global(.js) .hero-bg {
		opacity: 0;
		transform: translateY(32px);
	}
</style>
