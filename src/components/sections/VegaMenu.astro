---
import DiamondRule from '@/components/ui/DiamondRule.astro';

type MenuItem = {
	name: string;
	description?: string;
	price?: string;
};

type MenuCategory = {
	name: string;
	items: MenuItem[];
};

type MenuSection =
	| {
		heading: string;
		note?: string;
		date?: string;
		footer?: string;
		mode: 'list';
		categories: MenuCategory[];
	}
	| {
		heading: string;
		note?: string;
		date?: string;
		mode: 'file';
		fileUrl?: string;
		images?: string[];
	};

type Props = {
	sections: MenuSection[];
};

const { sections } = Astro.props;

const isPdf = (url: string) => url.toLowerCase().endsWith('.pdf');

// The parser extracts the date exactly as it's printed on the menu PDF —
// either "MM.DD.YYYY" (or an older "M.D.YY") or, with no day, "MM.YYYY".
function formatMenuDate(date?: string): string | undefined {
	if (!date) return undefined;

	const parts = date.split('.').map(Number);
	if (parts.some((part) => Number.isNaN(part))) return undefined;

	const hasDay = parts.length === 3;
	const [month, day, rawYear] = hasDay ? parts : [parts[0], undefined, parts[1]];
	const year = rawYear < 100 ? rawYear + 2000 : rawYear;

	const parsed = new Date(year, month - 1, day ?? 1);
	if (Number.isNaN(parsed.getTime())) return undefined;

	const formatted = parsed.toLocaleDateString(
		'en-US',
		hasDay ? { month: 'long', day: 'numeric', year: 'numeric' } : { month: 'long', year: 'numeric' }
	);

	return `Menu for ${formatted}`;
}
---

<section class="vega-menu section">
	<div class="container menu-container">
		{sections.map((section) => (
			<div class="menu-section" data-animate="fade-up" data-menu-mode={section.mode}>
				<h2 class="menu-section__heading">{section.heading}</h2>
				<DiamondRule width={30} class="menu-section__rule" />

				{formatMenuDate(section.date) && (
					<p class="menu-date">{formatMenuDate(section.date)}</p>
				)}

				{section.note && (
					<p class="menu-note">{section.note}</p>
				)}

				{section.mode === 'file' ? (
					section.images && section.images.length > 0 ? (
						<div class="menu-file menu-file--image menu-file--pages">
							{section.images.map((imageUrl) => (
								<img src={imageUrl} alt={`${section.heading} menu page`} loading="lazy" />
							))}
						</div>
					) : section.fileUrl ? (
						isPdf(section.fileUrl) ? (
							<div class="menu-file menu-file--pdf">
								<object data={section.fileUrl} type="application/pdf" class="menu-file__embed">
									<p class="menu-file__fallback">
										<a href={section.fileUrl} target="_blank" rel="noopener noreferrer">View Menu (PDF)</a>
									</p>
								</object>
								<p class="menu-file__link">
									<a href={section.fileUrl} target="_blank" rel="noopener noreferrer">Open in a new tab</a>
								</p>
							</div>
						) : (
							<div class="menu-file menu-file--image">
								<img src={section.fileUrl} alt={`${section.heading} menu`} loading="lazy" />
							</div>
						)
					) : (
						<p class="menu-empty">This menu is being updated — check back shortly.</p>
					)
				) : section.categories.length > 0 ? (
					<div class="menu-categories">
						{section.categories.map((cat) => (
							<div class="menu-category" data-animate="fade-up-sm" data-animate-stagger="0.06">
								<h3 class="menu-category__name">{cat.name}</h3>
								<DiamondRule width={22} class="menu-category__rule" />
								<ul class="menu-category__items">
									{cat.items.map((item) => (
										<li class="menu-item">
											<div class="menu-item__row">
												<span class="menu-item__name">{item.name}</span>
												{item.price && <span class="menu-item__price">{item.price}</span>}
											</div>
											{item.description && <p class="menu-item__desc">{item.description}</p>}
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
				) : (
					<p class="menu-empty">This menu is being updated — check back shortly.</p>
				)}

				{section.mode === 'list' && section.footer && (
					<p class="menu-pdf-note">{section.footer}</p>
				)}
			</div>
		))}
	</div>
</section>

<style lang="scss">
	.vega-menu {
		padding: 4rem 0 5rem;
	}

	.menu-container {
		max-width: 960px;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		gap: 4rem;
	}

	.menu-section {
		// background: var(--color-bg-muted, #F1EADD);
		background: #fff; 
		border: 2px dashed var(--color-border-dashed, #6B9C86);
		border-radius: var(--radius-dashed, 20px);
		padding: clamp(2rem, 5vw, 3.5rem);
	}

	.menu-section__heading {
		font-family: var(--font-primary), sans-serif;
		font-size: clamp(1.5rem, 3vw, 1.9rem);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		text-align: center;
		color: var(--color-charcoal, #221E1A);
		margin-bottom: 0.75rem;
	}

	:global(.menu-section__rule) {
		justify-content: center;
		margin-bottom: 1.5rem;
	}

	.menu-date {
		font-family: var(--font-secondary), sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-accent, #7C2E28);
		text-align: center;
		margin: 0 0 1rem;
	}

	.menu-note {
		font-family: var(--font-secondary), sans-serif;
		font-size: 1rem;
		font-style: italic;
		color: var(--color-text-muted, #6B6560);
		text-align: center;
		max-width: 52ch;
		margin: 0 auto 3rem;
	}

	.menu-pdf-note {
		font-family: var(--font-secondary), sans-serif;
		font-size: 0.9rem;
		font-style: italic;
		color: var(--color-text-muted, #6B6560);
		text-align: left;
		max-width: 100%;
		margin: 3rem auto 0;
		padding-top: 2rem;
		border-top: 1px solid var(--color-border-light, #EFE8DA);
	}

	.menu-empty {
		text-align: center;
		color: var(--color-text-muted, #6B6560);
		font-size: 1rem;
		padding: 2rem 0;
	}

	.menu-file--image {
		text-align: center;
	}

	.menu-file--image img {
		max-width: 100%;
		height: auto;
		border-radius: 12px;
	}

	.menu-file--pages {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.menu-file--pdf {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.menu-file__embed {
		width: 100%;
		height: 80vh;
		max-height: 900px;
		border: none;
		border-radius: 12px;
		background: #fff;
	}

	.menu-file__fallback {
		text-align: center;
		padding: 2rem 0;
	}

	.menu-file__link {
		text-align: center;
		margin: 0;
	}

	.menu-file__link a,
	.menu-file__fallback a {
		font-weight: 700;
		color: var(--color-accent, #7C2E28);
		text-decoration: underline;
	}

	.menu-categories {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 3rem 4rem;
	}

	@media (max-width: 680px) {
		.menu-categories {
			grid-template-columns: minmax(0, 1fr);
			gap: 2.5rem;
		}
	}

	.menu-category__name {
		font-family: var(--font-primary), sans-serif;
		font-size: 1.15rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		text-align: center;
		color: var(--color-charcoal, #221E1A);
		margin-bottom: 0.75rem;
	}

	:global(.menu-category__rule) {
		margin-bottom: 1.5rem;
	}

	.menu-category__items {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.menu-item {
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--color-border-light, #EFE8DA);
	}

	.menu-item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.menu-item__row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}

	.menu-item__name {
		font-weight: 700;
		font-size: 1rem;
		color: var(--color-charcoal, #221E1A);
	}

	.menu-item__price {
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--color-accent, #7C2E28);
		white-space: nowrap;
	}

	.menu-item__desc {
		font-size: 0.88rem;
		color: var(--color-text-muted, #6B6560);
		line-height: 1.6;
		margin: 0.35rem 0 0;
	}



	.menu-section[data-menu-mode="file"] {
		display: block;
		padding: 2rem 0;
	}
</style>
