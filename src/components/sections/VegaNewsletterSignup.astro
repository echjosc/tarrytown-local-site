---
import DiamondRule from '@/components/ui/DiamondRule.astro';

type Props = {
	title?: string;
	description?: string;
	placeholder?: string;
	buttonText?: string;
	formAction?: string;
};

const {
	title = "Join the Journal",
	description = "Receive seasonal recipes, event invitations, and morning thoughts from our kitchen to your inbox.",
	placeholder = "Your email address",
	buttonText = "Subscribe",
	formAction = "/api/newsletter",
} = Astro.props;
---

<section class="vega-newsletter">
	<div class="container newsletter-inner">
		<h2 class="newsletter-title" data-animate="fade-up">{title}</h2>
		<DiamondRule width={28} color="rgba(250, 246, 238, 0.55)" class="newsletter-divider" />
		<p class="newsletter-description" data-animate="fade-up-sm">{description}</p>
		<form class="newsletter-form" data-animate="fade-up-sm" action={formAction} method="post" novalidate>
			<input
				type="email"
				name="email"
				class="newsletter-input"
				placeholder={placeholder}
				required
				autocomplete="email"
			/>
			<button type="submit" class="newsletter-button">{buttonText}</button>
			<p class="newsletter-status" role="status" aria-live="polite" hidden></p>
		</form>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLFormElement>('.newsletter-form').forEach((form) => {
		const button = form.querySelector<HTMLButtonElement>('.newsletter-button');
		const status = form.querySelector<HTMLParagraphElement>('.newsletter-status');
		const input = form.querySelector<HTMLInputElement>('input[name="email"]');
		const buttonLabel = button?.textContent ?? '';

		const showStatus = (message: string, ok: boolean) => {
			if (!status) return;
			status.textContent = message;
			status.hidden = false;
			status.classList.toggle('is-error', !ok);
			status.classList.toggle('is-success', ok);
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!input || !button) return;

			button.disabled = true;
			button.textContent = 'Submitting…';

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email: input.value }),
				});
				const data = await response.json();

				if (response.ok && data.ok) {
					showStatus(data.message ?? 'Thanks for subscribing!', true);
					form.reset();
				} else {
					showStatus(data.error ?? 'Something went wrong. Please try again.', false);
				}
			} catch {
				showStatus('Something went wrong. Please try again.', false);
			} finally {
				button.disabled = false;
				button.textContent = buttonLabel;
			}
		});
	});
</script>


<style lang="scss">
	.vega-newsletter {
		--nl-bg: var(--color-bg-dark, #1F332A);
		--nl-text: rgba(250, 246, 238, 0.95);
		--nl-muted: rgba(250, 246, 238, 0.55);
		--nl-input-bg: rgba(255, 255, 255, 0.08);
		--nl-input-border: rgba(255, 255, 255, 0.2);
		--nl-button-bg: var(--color-bg, #FAF6EE);
		--nl-button-text: var(--color-charcoal, #221E1A);

		background-color: var(--nl-bg);
		padding: 5rem 1.5rem;

		.newsletter-inner {
			margin-inline: auto;
			text-align: center;
			display: flex;
			flex-direction: column;
			align-items: center;
			max-width: 800px;
		}

		.newsletter-title {
			font-size: clamp(1.6rem, 3.5vw, 2rem);
			font-weight: 800;
			font-family: var(--font-primary), sans-serif;
			text-transform: uppercase;
			letter-spacing: 0.02em;
			color: var(--nl-text);
			margin-bottom: 1rem;
			line-height: 1.2;
		}

		:global(.newsletter-divider) {
			margin-bottom: 1.5rem;
		}

		.newsletter-description {
			font-size: 0.95rem;
			color: var(--nl-muted);
			line-height: 1.7;
			margin-bottom: 2rem;
		}

		.newsletter-form {
			width: 100%;
			max-width: 380px;
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}

		.newsletter-input {
			width: 100%;
			padding: 0.85em 1.25em;
			background: var(--nl-input-bg);
			border: 1px solid var(--nl-input-border);
			border-radius: 0;
			color: var(--nl-text);
			font-size: 0.95rem;
			outline: none;
			transition: border-color 0.2s ease, background 0.2s ease;
			box-sizing: border-box;

			&::placeholder {
				color: var(--nl-muted);
			}

			&:focus {
				border-color: rgba(255, 255, 255, 0.5);
				background: rgba(255, 255, 255, 0.18);
			}
		}

		.newsletter-button {
			width: 100%;
			padding: 0.85em 1.25em;
			background: var(--nl-button-bg);
			color: var(--nl-button-text);
			font-size: 0.65rem;
			font-weight: 700;
			letter-spacing: 0.16em;
			text-transform: uppercase;
			border: none;
			border-radius: 0;
			cursor: pointer;
			transition: background 0.2s ease, opacity 0.2s ease;

			&:hover {
				background: var(--color-bg-muted, #F1EADD);
				opacity: 0.9;
			}

			&:disabled {
				opacity: 0.6;
				cursor: default;
			}
		}

		.newsletter-status {
			font-size: 0.85rem;
			line-height: 1.5;
			margin: 0;

			&.is-success {
				color: var(--nl-text);
			}

			&.is-error {
				color: #E8A2A2;
			}
		}

	}
</style>
