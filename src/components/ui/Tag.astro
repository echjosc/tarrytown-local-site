---
type Props = {
	label: string;
	variant?: 'default' | 'overlay';
};

const { label, variant = 'default' } = Astro.props;
---

<span class:list={['tag', `tag--${variant}`]}>{label}</span>

<style>
	.tag {
		display: inline-block;
		font-size: 0.6rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		border-radius: 0;
		padding: 0.2rem 0.55rem;
	}

	.tag--default {
		color: var(--color-primary-dark, #1F332A);
		background: var(--color-bg-muted, #F1EADD);
		border: 1px solid var(--color-border-dashed, #6B9C86);
	}

	.tag--overlay {
		color: rgba(250, 246, 238, 0.92);
		background: rgba(34, 30, 26, 0.5);
		backdrop-filter: blur(4px);
		border: 1px solid rgba(255, 255, 255, 0.18);
	}
</style>
