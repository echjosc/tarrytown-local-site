---
import type { HTMLAttributes } from 'astro/types';
import DiamondRule from '@/components/ui/DiamondRule.astro';

type Props = HTMLAttributes<'div'> & {
	title: string;
	subtitle?: string;
	icon?: string;
	align?: 'center' | 'left';
};

const { title, subtitle, icon, align = 'center', class: className, ...attrs } = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`, className]} {...attrs}>
	<h2 class="section-header__title">{title}</h2>

	<div class="section-header__divider">
		<DiamondRule width={36} />
		{icon && <span class="section-header__icon" set:html={icon} />}
	</div>

	{subtitle && <p class="section-header__subtitle">{subtitle}</p>}
</div>

<style>
	.section-header {
		margin-bottom: 3.5rem;
	}

	.section-header--center {
		text-align: center;
	}

	.section-header--left {
		text-align: left;
	}

	.section-header__title {
		font-family: var(--font-primary), sans-serif;
		font-size: clamp(1.6rem, 3vw, 2.5rem);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--color-charcoal, #221E1A);
		margin-bottom: 1rem;
	}

	/* ── Divider ─────────────────────────────────────────────── */
	.section-header__divider {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.section-header--center .section-header__divider {
		justify-content: center;
	}

	.section-header__icon {
		display: flex;
		align-items: center;
		color: var(--color-primary, #2E4A3B);
		flex-shrink: 0;
	}

	.section-header__icon :global(svg) {
		width: 16px;
		height: 16px;
	}

	/* ── Subtitle ────────────────────────────────────────────── */
	.section-header__subtitle {
		font-family: var(--font-secondary), sans-serif;
		font-size: 0.95rem;
		color: var(--color-text-muted, #6B6560);
		line-height: 1.75;
		margin: 0;
	}

	.section-header--center .section-header__subtitle {
		max-width: 560px;
		margin-inline: auto;
	}
</style>
