---
type Category = {
	label: string;
	icon: string;
};

type Props = {
	eyebrow?: string;
	title: string;
	subtitle?: string;
	categories?: Category[];
};

const { eyebrow, title, subtitle, categories } = Astro.props;
---

<section class="page-hero">
	<div class="container">
		{eyebrow && <p class="page-hero__eyebrow" data-animate="fade-up">{eyebrow}</p>}
		<h1 class="page-hero__title" data-animate="fade-up">{title}</h1>
		{subtitle && <p class="page-hero__subtitle" data-animate="fade-up">{subtitle}</p>}

		{categories && categories.length > 0 && (
			<nav class="page-hero__categories" aria-label="Categories">
				{categories.map((cat) => (
					<button class="page-hero__cat" type="button" data-animate="fade-up" data-animate-stagger="0.07">
						<span class="page-hero__cat-icon" set:html={cat.icon} />
						<span class="page-hero__cat-label">{cat.label}</span>
					</button>
				))}
			</nav>
		)}
	</div>
</section>

<style>
	.page-hero {
		text-align: center;
		padding: 4rem 1.5rem 3rem;
	}

	.page-hero__eyebrow {
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-accent, #7C2E28);
		margin-bottom: 1rem;
	}

	.page-hero__title {
		font-family: var(--font-primary), sans-serif;
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--color-charcoal, #221E1A);
		line-height: 1.15;
		margin-bottom: 0.6rem;
	}

	.page-hero__subtitle {
		font-family: var(--font-secondary), sans-serif;
		font-size: 0.95rem;
		color: var(--color-text-muted, #6B6560);
		margin-bottom: 2.5rem;
		letter-spacing: 0.01em;
	}

	.page-hero__categories {
		display: flex;
		justify-content: center;
		gap: 2.5rem;
		flex-wrap: wrap;
	}

	.page-hero__cat {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
	}

	.page-hero__cat-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 52px;
		background: var(--color-bg-muted, #F1EADD);
		border: 2px dashed var(--color-border-dashed, #6B9C86);
		border-radius: 0;
		color: var(--color-primary, #2E4A3B);
		transition: background 0.2s ease, color 0.2s ease;
	}

	.page-hero__cat:hover .page-hero__cat-icon {
		background: var(--color-charcoal, #221E1A);
		border-color: var(--color-charcoal, #221E1A);
		color: white;
	}

	.page-hero__cat-label {
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-light, #9A9186);
	}
</style>
