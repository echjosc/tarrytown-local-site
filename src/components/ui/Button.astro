---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
    href?: string;
    variant?: 'primary' | 'secondary';
};

const { class: className, variant = 'primary', ...rest } = Astro.props;
---

<a
	class:list={["ui-button", `ui-button--${variant}`, className]}
	{...rest}
>
	<slot />
</a>

<style lang="scss">
	.ui-button {
		display: inline-block;
		padding: 0.7em 1.6em;
		background-color: var(--color-charcoal, #221E1A);
		color: var(--color-bg, #FAF6EE);
		border: 1.5px solid var(--color-charcoal, #221E1A);
		border-radius: 0;
		box-shadow: var(--shadow-hard);
		cursor: pointer;
		text-decoration: none;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;

		&:hover {
			background-color: var(--color-primary, #2E4A3B);
			border-color: var(--color-primary, #2E4A3B);
			color: var(--color-bg, #FAF6EE);
		}
	}

	.ui-button--secondary {
		background-color: transparent;
		color: var(--color-charcoal, #221E1A);
		border: 1.5px solid var(--color-charcoal, #221E1A);

		&:hover {
			background-color: var(--color-primary, #2E4A3B);
			border-color: var(--color-primary, #2E4A3B);
			color: var(--color-bg, #FAF6EE);
		}
	}
</style>
