---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
    src: ImageMetadata | string;
    alt: string;
    width?: number;
    height?: number;
    class?: string;
    loading?: 'lazy' | 'eager';
    fetchpriority?: 'high' | 'low' | 'auto';
    position?: `${'top' | 'center' | 'bottom'} ${'left' | 'center' | 'right'}` | 'center';

};

const { src, alt, width = undefined, height = undefined, class: className, loading = 'lazy', fetchpriority, position = 'center' } = Astro.props;
---

<div class:list={["ui-image-container", className].filter(Boolean)}>
    {typeof src === 'object' && src !== null ? (
        <Image src={src} alt={alt} width={width} height={height} class:list={["ui-image"]} loading={loading} fetchpriority={fetchpriority} style={`object-position: ${position};`} />
    ) : (
        <img src={src} alt={alt} width={width} height={height} class={"ui-image"} loading={loading} fetchpriority={fetchpriority} style={`object-position: ${position};`} />
    )}
</div>

<style lang="scss">    .ui-image-container {
        position: relative;
        overflow: hidden;
        // width: 100%;
        // height: auto;
    }

    .ui-image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transition: transform 0.3s ease;


        &:hover {
            // transform: scale(1.05);
        }
    }

</style>