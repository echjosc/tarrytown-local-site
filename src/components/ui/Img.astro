---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
    src: ImageMetadata | string;
    alt: string;
    width?: number;
    height?: number;
    class?: string;
    loading?: 'lazy' | 'eager';
    fetchpriority?: 'high' | 'low' | 'auto';
    position?: `${'top' | 'center' | 'bottom'} ${'left' | 'center' | 'right'}` | 'center';
    /** Force a specific output format (e.g. 'png' for logos/flat-color graphics, to avoid lossy re-encoding softening crisp edges/text). Omit to let the image service auto-negotiate. */
    format?: 'avif' | 'jpg' | 'png' | 'webp';
    /** 1-100, or a preset. Defaults to the image service's own default if omitted. */
    quality?: number | 'low' | 'mid' | 'high' | 'max';
    /** Pixel-density variants for the srcset (e.g. [1, 2, 3] for 1x/2x/3x). The on-screen CSS size is unaffected — this just lets high-DPI screens (basically every phone) load a sharper source instead of an upscaled 1x image. Defaults to [1, 2] whenever `width` is set; pass `false` to opt out. */
    densities?: (number | `${number}x`)[] | false;
    /** How the source is resized to fit the requested width/height box. Defaults to 'cover' whenever both width and height are set, matching the object-fit: cover this component renders with. */
    fit?: 'contain' | 'cover' | 'fill' | 'inside' | 'outside' | 'scale-down';
    /** Generates a width-based srcset (instead of the default density-based 1x/2x) for images whose *displayed* size varies a lot across viewports, e.g. a full-bleed hero. 'full-width': displayed at ~100vw at every breakpoint. 'constrained': scales down below `width` but never exceeds it. Omit for images with a roughly fixed display size (logos, avatars, framed photos), where density-based srcset is enough. */
    layout?: 'full-width' | 'constrained';

};

const {
    src,
    alt,
    width = undefined,
    height = undefined,
    class: className,
    loading = 'lazy',
    fetchpriority,
    position = 'center',
    format,
    quality,
    densities: densitiesProp,
    fit: fitProp,
    layout,
} = Astro.props;

const densities = layout ? undefined : densitiesProp === false ? undefined : densitiesProp ?? (width ? [1, 2] : undefined);
const fit = fitProp ?? (width && height ? 'cover' : undefined);
---

<div class:list={["ui-image-container", className].filter(Boolean)}>
    {typeof src === 'object' && src !== null ? (
        <Image src={src} alt={alt} width={width} height={height} format={format} quality={quality} densities={densities} fit={fit} layout={layout} class:list={["ui-image"]} loading={loading} fetchpriority={fetchpriority} style={`object-position: ${position};`} />
    ) : (
        <img src={src} alt={alt} width={width} height={height} class={"ui-image"} loading={loading} fetchpriority={fetchpriority} style={`object-position: ${position};`} />
    )}
</div>

<style lang="scss">    .ui-image-container {
        position: relative;
        overflow: hidden;
        // width: 100%;
        // height: auto;
    }

    .ui-image {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        transition: transform 0.3s ease;


        &:hover {
            // transform: scale(1.05);
        }
    }

</style>