<section class="markdoc-footnotes">
	<hr />
	<ol>
		<slot />
	</ol>
</section>

<style lang="scss" is:global>
	.markdoc-footnotes {
		font-size: 0.875rem;
		line-height: 1.5;
		margin-top: 2rem;

		hr {
			border: none;
			border-top: 1px solid var(--color-border);
			margin-bottom: 1rem;
		}

		ol {
			padding-left: 1.5rem;
			margin-left: 0;
		}
	}
