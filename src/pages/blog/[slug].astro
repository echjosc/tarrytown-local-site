---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import VegaInteriorBanner from '@/components/sections/VegaInteriorBanner.astro';
import { resolveImage } from '@/utils/resolveImage';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(dateStr?: string) {
	if (!dateStr) return '';
	return new Date(dateStr).toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	});
}

const postDate = post.data.date ? new Date(post.data.date).toISOString() : undefined;
---

<Base
	title={post.data.title}
	description={post.data.excerpt}
	ogType="article"
	publishedTime={postDate}
>
	<article class="blog-post">
		<a href="/blog" class="blog-post__back container-inline">&larr; Back to The Good Dirt</a>

		<VegaInteriorBanner
			title={post.data.title}
			imageSrc={resolveImage(post.data.featuredImage) ?? post.data.featuredImage}
			tags={post.data.tags}
			author={post.data.author}
			date={postDate}
		/>

		<!-- Content -->
		<div class="container">
			<div class="prose">
				<Content />
			</div>
		</div>

		<!-- Footer nav -->
		<footer class="blog-post__footer container">
			<a href="/blog" class="btn btn--secondary">&larr; All Posts</a>
		</footer>
	</article>
</Base>

<style>
/* ── Back link ───────────────────────────────────────────── */
.blog-post__back {
	display: inline-block;
	font-size: var(--font-size-sm);
	font-weight: 500;
	color: var(--color-text-muted);
	padding: var(--space-4) 0;
	text-decoration: none;
}
.blog-post__back:hover {
	color: var(--color-primary);
}
.container-inline {
	max-width: 1100px;
	margin: 0 auto;
	padding: 0 1.5rem;
	display: block;
}

/* ── Prose enhancements ──────────────────────────────────── */
.prose {
	padding-bottom: var(--space-12);
}
.prose h2 {
	margin-top: var(--space-12);
	margin-bottom: var(--space-4);
}
.prose h3 {
	margin-top: var(--space-8);
	margin-bottom: var(--space-3);
}
.prose p {
	line-height: 1.8;
	margin-bottom: var(--space-4);
}
.prose ul,
.prose ol {
	margin-bottom: var(--space-4);
	padding-left: var(--space-6);
	color: var(--color-text-muted);
}
.prose li {
	margin-bottom: var(--space-2);
	line-height: 1.7;
}
.prose strong {
	color: var(--color-text);
	font-weight: 600;
}
.prose code {
	background: var(--color-bg-muted);
	padding: 0.15em 0.4em;
	border-radius: var(--radius-sm);
	font-size: 0.875em;
}
.prose pre {
	background: #1e1e2e;
	color: #cdd6f4;
	border-radius: var(--radius-md);
	padding: var(--space-6);
	overflow-x: auto;
	margin-bottom: var(--space-6);
	font-size: var(--font-size-sm);
	line-height: 1.7;
	border: 1px solid var(--color-border);
}
.prose pre code {
	background: none;
	padding: 0;
	border-radius: 0;
	font-size: inherit;
	color: inherit;
}
.prose blockquote {
	border-left: 2px solid var(--color-accent, #7C2E28);
	padding-left: var(--space-6);
	margin: var(--space-6) 0;
	font-family: var(--font-secondary), sans-serif;
	color: var(--color-text-muted);
}
.prose table {
	width: 100%;
	border-collapse: collapse;
	margin-bottom: var(--space-6);
	font-size: var(--font-size-sm);
}
.prose th,
.prose td {
	padding: var(--space-3) var(--space-4);
	border: 1px solid var(--color-border);
	text-align: left;
}
.prose th {
	background: var(--color-bg-muted);
	font-weight: 600;
	color: var(--color-text);
}
.prose td {
	color: var(--color-text-muted);
}

/* ── Footnotes ───────────────────────────────────────────── */
.prose .footnote-ref {
	font-size: 0.75em;
	font-weight: 600;
	color: var(--color-primary);
	text-decoration: none;
	vertical-align: super;
	line-height: 0;
}
.prose .footnote-ref:hover {
	text-decoration: underline;
}
.prose .footnotes {
	margin-top: var(--space-12);
}
.prose .footnotes hr {
	border: none;
	border-top: 1px solid var(--color-border);
	margin-bottom: var(--space-6);
}
.prose .footnotes ol {
	padding-left: var(--space-6);
	color: var(--color-text-muted);
	font-size: var(--font-size-sm);
}
.prose .footnotes li {
	margin-bottom: var(--space-3);
	line-height: 1.6;
}
.prose .footnote-back {
	color: var(--color-primary);
	text-decoration: none;
	margin-left: 0.25em;
}
.prose .footnote-back:hover {
	text-decoration: underline;
}

/* ── Post footer ─────────────────────────────────────────── */
.blog-post__footer {
	padding-block: var(--space-8) var(--space-16);
	border-top: 1px solid var(--color-border);
}
</style>
