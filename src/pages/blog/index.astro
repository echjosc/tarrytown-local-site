---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import VegaJournal from '@/components/sections/VegaJournal.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const blogPage = await reader.singletons.blogPage.read();

const allPosts = await getCollection('posts');

const posts = allPosts
	.filter((post) => import.meta.env.DEV || !post.data.draft)
	.sort((a, b) => {
		const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
		const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
		return dateB - dateA;
	});
---

<Base
	title={blogPage?.seoTitle || 'The Good Dirt'}
	description={blogPage?.seoDescription || 'Stories from the Hudson Valley.'}
>
	<VegaJournal
		{posts}
		eyebrow={blogPage?.eyebrow || undefined}
		title={blogPage?.heroTitle || undefined}
		subtitle={blogPage?.heroSubtitle || undefined}
	/>
</Base>
