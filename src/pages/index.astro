---
import VegaMainHero from "@/components/sections/VegaMainHero.astro";
import Base from "@/layouts/Base.astro";
import { createReader } from '@keystatic/core/reader';
import VegaOfferings from "@/components/sections/VegaOfferings.astro";
import VegaNewsletterSignup from "@/components/sections/VegaNewsletterSignup.astro";
import VegaLocation from "@/components/sections/VegaLocation.astro";
import VegaCommitments from "@/components/sections/VegaCommitments.astro";
import VegaPhilosophyBanner from "@/components/sections/VegaPhilosophyBanner.astro";
import VegaSourcingStandards from "@/components/sections/VegaSourcingStandards.astro";

import keystaticConfig from '../../keystatic.config';
import { resolveImage } from '@/utils/resolveImage';
const reader = createReader(process.cwd(), keystaticConfig);
const homepage = await reader.singletons.homepage.read();
const businessInfo = await reader.singletons.businessInfo.read();

---

<Base
	title="Home"
	description="Tarrytown Local is a restaurant in Tarrytown, NY. We serve seasonal, locally-sourced dishes that celebrate the bounty of our region."
>
	<!-- ── Hero ─────────────────────────────────────────────── -->
	<VegaMainHero
		eyebrow={homepage?.hero.eyebrow || 'Coming Spring 2025'}
		title={homepage?.hero.headline || 'Welcome to Tarrytown Local'}
		description={homepage?.hero.description || 'Experience the best of our region with every bite. Join us for a meal that celebrates local flavors and community.'}
		imageSrc={resolveImage(homepage?.hero.image)}
		buttons={
			homepage?.hero.buttons
				? homepage.hero.buttons.map((btn) => ({
						text: btn.text,
						url: btn.url // use only 'url' property
					}))
				: [
						{ text: 'Peek The Menu', url: '/menu' },
						{ text: 'Our Story', url: '/about' },
					]
		}
	/>

	<!-- Offerings -->
	<VegaOfferings
		sectionTitle={homepage?.offerings?.sectionTitle || "What We Do"}
		featured={{
			eyebrow: homepage?.offerings?.featured?.eyebrow || undefined,
			title: homepage?.offerings?.featured?.title || "Dine-in Cafe",
			description: homepage?.offerings?.featured?.description || "A cozy spot to enjoy our seasonal menu, and fresh baked goods. Perfect for breakfast, lunch, or a casual catch-up.",
			imageSrc: resolveImage(homepage?.offerings?.featured?.image),
			imageAlt: homepage?.offerings?.featured?.imageAlt || undefined,
			linkText: homepage?.offerings?.featured?.linkText || "Explore Our Menu",
			linkUrl: homepage?.offerings?.featured?.linkUrl || "/menu",
		}}
		cards={
			homepage?.offerings?.cards?.length
				? (homepage.offerings.cards.map((card) => ({
						title: card.title,
						description: card.description,
						linkText: card.linkText || undefined,
						linkUrl: card.linkUrl || undefined,
					})) as [typeof homepage.offerings.cards[0], typeof homepage.offerings.cards[0]])
				: [
						{
							title: "Mill & Bakery",
							description: "We mill our own flour daily to ensure the highest nutrient density and flavor in every loaf. Our pastries are the perfect accompaniment to your morning coffee.",
							linkText: "Check Out Our Breads",
							linkUrl: "/menu#breads",
						},
						{
							title: "Grab & Go",
							description: "Perfectly packed pastries and artisanal sandwiches for your Tarrytown adventures. Swing by for a quick bite or a picnic in the park.",
							linkText: "View Grab & Go Options",
							linkUrl: "/menu#grab-and-go",
						},
					]
		}
	/>

	<!-- Philosophy / Commitments Banner -->
	{(homepage?.commitments?.quote || homepage?.commitments?.items?.length) ? (
		<VegaPhilosophyBanner
			quote={homepage.commitments.quote || undefined}
			ctaText={homepage.commitments.ctaText || 'Explore Our Commitments'}
			ctaUrl={homepage.commitments.ctaUrl || '/about'}
			items={homepage.commitments.items?.map((item) => ({
				title: item.title,
				description: item.description,
			})) ?? []}
		/>
	) : null}

	<!-- Location Section (address, phone & hours sourced from Business Info singleton) -->
	<VegaLocation
		title={homepage?.location?.title || "Find Us"}
		addressLines={businessInfo?.addressLines?.length ? [...businessInfo.addressLines] : ["123 Main Street", "Tarrytown, NY 10591"]}
		hoursTitle={homepage?.location?.hoursTitle || "Hours of Operation"}
		hours={businessInfo?.hours?.length ? businessInfo.hours.map((row) => ({ ...row })) : [
			{ days: "Monday - Friday", hours: "7am - 7pm" },
			{ days: "Saturday", hours: "8am - 8pm" },
			{ days: "Sunday", hours: "8am - 6pm" },
		]}
		phone={businessInfo?.phone || undefined}
		directionsUrl={homepage?.location?.directionsUrl || "#"}
		directionsText={homepage?.location?.directionsText || "Get Directions"}
		mapEmbedUrl={businessInfo?.mapEmbedUrl || undefined}
		mapLabel={homepage?.location?.mapLabel || "Tarrytown Local Location"}
	/>

	<!-- Newsletter Signup -->
	<VegaNewsletterSignup
		title={homepage?.newsletter?.title || "Stay in the Loop"}
		description={homepage?.newsletter?.description || "Sign up for our newsletter to get the latest updates on our opening, menu launches, and special events. We promise to only send you the good stuff."}
		placeholder={homepage?.newsletter?.placeholder || "Enter your email address"}
		buttonText={homepage?.newsletter?.buttonText || "Subscribe"}
	/>

	
</Base>

<style>
	/* ── Hero ────────────────────────────────────────────────── */
	.hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: hidden;
		padding-block: var(--space-24) var(--space-16);
	}
	.hero-blob {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.25;
		pointer-events: none;
	}
	.hero-blob--1 {
		width: 600px;
		height: 600px;
		background: var(--color-primary);
		top: -150px;
		right: -150px;
		animation: blobFloat 8s ease-in-out infinite;
	}
	.hero-blob--2 {
		width: 400px;
		height: 400px;
		background: var(--color-accent);
		bottom: -80px;
		left: -80px;
		animation: blobFloat 10s ease-in-out infinite reverse;
	}
	@keyframes blobFloat {
		0%,
		100% {
			transform: translate(0, 0) scale(1);
		}
		33% {
			transform: translate(20px, -30px) scale(1.05);
		}
		66% {
			transform: translate(-15px, 20px) scale(0.97);
		}
	}

	.hero-inner {
		display: flex;
		align-items: center;
		gap: var(--space-12);
		flex-direction: column;
	}
	@media (min-width: 900px) {
		.hero-inner {
			flex-direction: row;
		}
	}
	.hero-content {
		flex: 1;
		max-width: 580px;
	}
	.hero-eyebrow {
		display: inline-block;
		font-size: var(--font-size-sm);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-primary);
		background: rgba(79, 70, 229, 0.08);
		border: 1px solid rgba(79, 70, 229, 0.2);
		padding: 0.35rem 0.85rem;
		border-radius: var(--radius-full);
		margin-bottom: var(--space-6);
		opacity: 0;
	}
	.hero-headline {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.03em;
		margin-bottom: var(--space-6);
	}
	.hero-headline em {
		font-style: normal;
		background: linear-gradient(
			135deg,
			var(--color-primary),
			var(--color-accent)
		);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	/* word split spans are hidden initially by JS */
	.hero-headline .word {
		display: inline-block;
		overflow: hidden;
	}
	.hero-headline .word-inner {
		display: inline-block;
	}
	.hero-sub {
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
		max-width: 480px;
		line-height: 1.7;
		margin-bottom: var(--space-8);
		opacity: 0;
	}
	.hero-actions {
		display: flex;
		gap: var(--space-4);
		flex-wrap: wrap;
		opacity: 0;
	}

	/* Floating card */
	.hero-card {
		flex-shrink: 0;
		width: 300px;
		opacity: 0;
	}
	.hero-card__inner {
		background: white;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-6);
		box-shadow: var(--shadow-lg);
	}
	.hero-card__header {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin-bottom: var(--space-6);
	}
	.hero-card__dots {
		display: flex;
		gap: 5px;
	}
	.hero-card__dots span {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--color-border);
	}
	.hero-card__dots span:first-child {
		background: #f87171;
	}
	.hero-card__dots span:nth-child(2) {
		background: #fbbf24;
	}
	.hero-card__dots span:last-child {
		background: #34d399;
	}
	.hero-card__title {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-text-muted);
	}
	.hero-card__stat {
		display: flex;
		flex-direction: column;
		margin-bottom: var(--space-4);
	}
	.hero-card__value {
		font-family: var(--font-heading);
		font-size: var(--font-size-3xl);
		font-weight: 800;
		color: #34d399;
		line-height: 1;
	}
	.hero-card__label {
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		margin-top: var(--space-1);
	}
	.hero-card__bar {
		height: 6px;
		background: var(--color-bg-muted);
		border-radius: var(--radius-full);
		margin-bottom: var(--space-4);
		overflow: hidden;
	}
	.hero-card__bar-fill {
		height: 100%;
		width: 75%;
		background: linear-gradient(
			90deg,
			var(--color-primary),
			var(--color-accent)
		);
		border-radius: var(--radius-full);
	}
	.hero-card__row {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}
	.hero-card__tag {
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.2rem 0.6rem;
		border-radius: var(--radius-full);
	}
	.hero-card__tag--green {
		background: rgba(52, 211, 153, 0.15);
		color: #059669;
		border: 1px solid rgba(52, 211, 153, 0.3);
	}
	.hero-card__meta {
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
	}

	.hero-scroll-hint {
		position: absolute;
		bottom: var(--space-8);
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		opacity: 0;
	}
	.hero-scroll-hint span {
		font-size: 0.7rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}
	.hero-scroll-line {
		width: 1px;
		height: 40px;
		background: linear-gradient(
			to bottom,
			var(--color-primary),
			transparent
		);
		animation: scrollPulse 2s ease-in-out infinite;
	}
	@keyframes scrollPulse {
		0% {
			opacity: 1;
			transform: scaleY(1);
			transform-origin: top;
		}
		50% {
			opacity: 0.4;
		}
		100% {
			opacity: 1;
			transform: scaleY(1);
		}
	}

	/* ── Section shared ──────────────────────────────────────── */
	.eyebrow {
		display: inline-block;
		font-size: var(--font-size-sm);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-primary);
		margin-bottom: var(--space-4);
	}
	.section-header {
		max-width: 560px;
		margin: 0 auto var(--space-12);
	}
	.section-header h2 {
		margin-bottom: var(--space-4);
	}
	.section-lead {
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
		margin: 0;
	}

	/* ── Features ────────────────────────────────────────────── */
	.features-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-6);
	}
	@media (min-width: 640px) {
		.features-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1024px) {
		.features-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.feature-card {
		opacity: 0;
		transform: translateY(30px);
	}
	.feature-icon {
		font-size: 1.75rem;
		color: var(--color-primary);
		margin-bottom: var(--space-4);
		display: inline-block;
	}
	.feature-card h3 {
		font-size: var(--font-size-xl);
		margin-bottom: var(--space-2);
	}
	.feature-card p {
		font-size: var(--font-size-sm);
		margin: 0;
		line-height: 1.7;
	}

	/* ── Stats ───────────────────────────────────────────────── */
	.stats-section {
		background: var(--color-bg-muted);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-8);
		text-align: center;
	}
	@media (min-width: 768px) {
		.stats-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.stat-item {
		opacity: 0;
	}
	.stat-value {
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 800;
		color: var(--color-primary);
		line-height: 1;
		letter-spacing: -0.03em;
	}
	.stat-suffix {
		font-family: var(--font-heading);
		font-size: var(--font-size-2xl);
		font-weight: 800;
		color: var(--color-accent);
	}
	.stat-label {
		display: block;
		margin-top: var(--space-2);
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		font-weight: 500;
	}

	/* ── Marquee ─────────────────────────────────────────────── */
	.marquee-track {
		overflow: hidden;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
		padding-block: var(--space-4);
		background: white;
	}
	.marquee-inner {
		display: flex;
		gap: var(--space-8);
		width: max-content;
		white-space: nowrap;
		font-family: var(--font-heading);
		font-size: var(--font-size-lg);
		font-weight: 700;
		color: var(--color-text-muted);
		letter-spacing: -0.01em;
	}
	.marquee-dot {
		color: var(--color-primary);
	}

	/* ── CTA ─────────────────────────────────────────────────── */
	.cta-section {
		background: var(--color-bg);
	}
	.cta-box {
		position: relative;
		background: linear-gradient(135deg, var(--color-primary), #6d28d9);
		border-radius: var(--radius-lg);
		padding: var(--space-16) var(--space-12);
		text-align: center;
		overflow: hidden;
		opacity: 0;
	}
	.cta-blob {
		position: absolute;
		width: 500px;
		height: 500px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.06);
		top: -200px;
		right: -100px;
		pointer-events: none;
	}
	.cta-box .eyebrow {
		color: rgba(255, 255, 255, 0.7);
	}
	.cta-box h2 {
		color: white;
		font-size: clamp(2rem, 4vw, 3rem);
		margin-bottom: var(--space-4);
	}
	.cta-box h2 em {
		font-style: normal;
		opacity: 0.85;
	}
	.cta-box p {
		color: rgba(255, 255, 255, 0.75);
		font-size: var(--font-size-lg);
		max-width: 480px;
		margin: 0 auto var(--space-8);
	}
	.cta-box .btn--primary {
		background: white;
		color: var(--color-primary);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
	}
	.cta-box .btn--primary:hover {
		background: var(--color-bg-muted);
		color: var(--color-primary-dark);
	}

	/* ── Magnetic cursor helper ──────────────────────────────── */
	[data-magnetic] {
		transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
	}

	/* ── Reduced motion ──────────────────────────────────────── */
	@media (prefers-reduced-motion: reduce) {
		.hero-blob,
		.hero-scroll-line {
			animation: none;
		}
	}
</style>

<script>
	import gsap from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	/* ── 1. Scroll-triggered fade-up elements ────────────── */
	if (!prefersReduced) {
		document
			.querySelectorAll<HTMLElement>('[data-animate="fade-up"]')
			.forEach((el) => {
				gsap.set(el, { opacity: 0, y: 30 });
				ScrollTrigger.create({
					trigger: el,
					start: "top 88%",
					onEnter: () => {
						gsap.to(el, {
							opacity: 1,
							y: 0,
							duration: 0.7,
							ease: "power3.out",
						});
					},
				});
			});

		document
			.querySelectorAll<HTMLElement>('[data-animate="slide-left"]')
			.forEach((el) => {
				gsap.set(el, { opacity: 0, x: 60 });
				ScrollTrigger.create({
					trigger: el,
					start: "top 88%",
					onEnter: () => {
						gsap.to(el, {
							opacity: 1,
							x: 0,
							duration: 0.8,
							ease: "power3.out",
						});
					},
				});
			});

	} else {
		// Reduced motion: just show everything
		document
			.querySelectorAll<HTMLElement>("[data-animate]")
			.forEach((el) => {
				el.style.opacity = "1";
				el.style.transform = "none";
			});
	}

	/* ── 5. Marquee ──────────────────────────────────────── */
	const marqueeInner = document.getElementById("marquee-inner");
	if (marqueeInner && !prefersReduced) {
		// Duplicate content inside the single container for a seamless loop
		marqueeInner.innerHTML += marqueeInner.innerHTML;
		gsap.to(marqueeInner, {
			x: "-50%",
			duration: 30,
			ease: "none",
			repeat: -1,
		});
	}

	/* ── 6. Magnetic buttons ─────────────────────────────── */
	if (!prefersReduced) {
		document
			.querySelectorAll<HTMLElement>("[data-magnetic]")
			.forEach((btn) => {
				btn.addEventListener("mousemove", (e) => {
					const rect = btn.getBoundingClientRect();
					const cx = rect.left + rect.width / 2;
					const cy = rect.top + rect.height / 2;
					const dx = (e.clientX - cx) * 0.3;
					const dy = (e.clientY - cy) * 0.3;
					gsap.to(btn, {
						x: dx,
						y: dy,
						duration: 0.3,
						ease: "power2.out",
					});
				});
				btn.addEventListener("mouseleave", () => {
					gsap.to(btn, {
						x: 0,
						y: 0,
						duration: 0.5,
						ease: "elastic.out(1, 0.5)",
					});
				});
			});
	}
</script>
