---
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/ui/PageHero.astro";
import EventCalendar, { type CalendarEvent } from "@/components/react/EventCalendar";
import { getImage } from "astro:assets";
import { resolveImage } from "@/utils/resolveImage";
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const allEvents = await reader.collections.events.all();

const events: CalendarEvent[] = await Promise.all(
	allEvents
		.filter(({ entry }) => entry.date)
		.map(async ({ slug, entry }) => {
			const poster = resolveImage(entry.image);
			const optimizedPoster = poster ? await getImage({ src: poster, width: 800, format: 'webp' }) : undefined;
			return {
				slug,
				title: entry.title,
				date: entry.date as string,
				time: entry.time || undefined,
				category: entry.category,
				location: entry.location || undefined,
				description: entry.description || undefined,
				link: entry.link || undefined,
				image: optimizedPoster?.src,
				repeatsWeekly: entry.repeat.discriminant === 'weekly',
				repeatUntil: (entry.repeat.discriminant === 'weekly' && entry.repeat.value.until) || undefined,
				skipDates: entry.repeat.discriminant === 'weekly' ? entry.repeat.value.skipDates.filter((skipDate): skipDate is string => Boolean(skipDate)) : undefined,
			};
		}),
);
---

<Base
	title="Events Calendar"
	description="See what's coming up at Tarrytown Local: special dinners, cooking classes, live music and more."
>
	<PageHero
		eyebrow="Calendar"
		title="What's Happening"
		subtitle="Special dinners, cooking classes, live music, and everything else happening at Tarrytown Local."
	/>

	<div class="calendar-section" data-animate="fade-up">
		<EventCalendar client:only="react" events={events} />
	</div>
</Base>

<style>
	.calendar-section {
		padding-bottom: var(--space-20);
	}
</style>
