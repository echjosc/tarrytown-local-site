---
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/ui/PageHero.astro";
import VegaMenu from "@/components/sections/VegaMenu.astro";
import Schema from "@/components/seo/Schema.astro";
import { menu as menuSchema } from "@/lib/schemas/schemas";
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const menuPage = await reader.singletons.menuPage.read();

type MenuPageData = NonNullable<typeof menuPage>;

type GeneratedMenu = {
	note?: string;
	categories: { name: string; items: { name: string; description?: string; price?: string }[] }[];
};

// scripts/parse-menu-pdfs.mjs runs before every build: if a menu section is an
// uploaded PDF, it extracts the text and writes the structured result here, so
// it can render as real HTML instead of an embedded PDF. Missing files (not a
// PDF, or nothing parseable) just mean the glob below has no entry for them.
const generatedMenus = import.meta.glob('/src/data/generated/menu/*.json', {
	eager: true,
	import: 'default',
}) as Record<string, GeneratedMenu>;

function buildMenuSection(
	section: MenuPageData['restaurantMenu'] | undefined,
	fallbackHeading: string,
	generatedFile: string
) {
	const note = section?.note || undefined;
	const heading = section?.heading || fallbackHeading;

	if (section?.display?.discriminant === 'file') {
		const fileUrl = section.display.value?.file || undefined;
		const skipPdfParse = section.display.value?.skipPdfParse ?? false;
		const generated = !skipPdfParse && fileUrl?.toLowerCase().endsWith('.pdf')
			? generatedMenus[`/src/data/generated/menu/${generatedFile}`]
			: undefined;

		if (generated && generated.categories.length > 0) {
			return { heading, note: note || generated.note, mode: 'list' as const, categories: generated.categories };
		}

		return { heading, note, mode: 'file' as const, fileUrl };
	}

	const categories = (section?.display?.value ?? []).map((cat) => ({
		name: cat.name,
		items: cat.items.map((item) => ({
			name: item.name,
			description: item.description || undefined,
			price: item.price || undefined,
		})),
	}));
	return { heading, note, mode: 'list' as const, categories };
}

const menuSections = [
	buildMenuSection(menuPage?.restaurantMenu, 'Restaurant Menu', 'restaurant-menu.json'),
	buildMenuSection(menuPage?.bakeryMenu, 'Bakery Menu', 'bakery-menu.json'),
];

// Only list-mode sections have structured items — file-mode sections just
// link out to a PDF/image and have nothing for a Menu schema to describe.
const menuSchemaSections = menuSections
	.filter((section) => section.mode === 'list')
	.flatMap((section) => section.categories ?? [])
	.filter((category) => category.items.length > 0)
	.map((category) => ({
		name: category.name,
		items: category.items,
	}));

const menuJsonLd = menuSchema({
	name: 'Tarrytown Local Menu',
	sections: menuSchemaSections,
});
---

<Base
	title={menuPage?.seoTitle || "Menu"}
	description={menuPage?.seoDescription || "See what's cooking today at Tarrytown Local — our menu changes daily."}
>
	<!-- Hero -->
	<PageHero
		eyebrow="Menu"
		title={menuPage?.heroTitle || "Today's Menu"}
		subtitle={menuPage?.heroSubtitle || undefined}
	/>

	<!-- Menu -->
	<VegaMenu sections={menuSections} />

	{menuSchemaSections.length > 0 && <Schema item={menuJsonLd} />}
</Base>
