---
import Base from "@/layouts/Base.astro";
import VegaContactForm from "@/components/sections/VegaContactForm.astro";
import PageHero from "@/components/ui/PageHero.astro";
import InteractiveMap from "@/components/react/InteractiveMap";
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const farmersPage = await reader.singletons.farmersPage.read();
---

<Base
	title="Contact | Tarrytown Local"
	description="Reach out to Tarrytown Local for inquiries about private events, catering, press, or just to say hello."
>
	<!-- ── Hero ──────────────────────────────────────────────── -->
	<PageHero
		title={farmersPage?.heroTitle || "The Hands That Feed Us"}
		subtitle={farmersPage?.heroSubtitle || undefined}
	/>

	<InteractiveMap
		client:only="react"
		coordinates={farmersPage?.locations?.length
			? farmersPage.locations.map((loc) => ({
					lat: loc.lat ?? 0,
					lng: loc.lng ?? 0,
					title: loc.title || undefined,
					description: loc.description || undefined,
					type: (loc.type as 'home' | 'produce' | 'meat' | 'farm') || 'farm',
					url: loc.url || undefined,
					image: loc.image || undefined,
				}))
			: undefined
		}
	/>

	
</Base>

<style lang="scss">
	
</style>
