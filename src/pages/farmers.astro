---
import Base from "@/layouts/Base.astro";
import PageHero from "@/components/ui/PageHero.astro";
import InteractiveMap from "@/components/react/InteractiveMap";
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const farmersPage = await reader.singletons.farmersPage.read();

const farmPartners = (farmersPage?.locations ?? []).filter((loc) => loc.type !== 'home');
---

<Base
	title="Where We Get Our Food"
	description="Meet the farmers and producers we work with across the Hudson Valley, and see where the food we serve and sell actually comes from."
>
	<!-- ── Hero ──────────────────────────────────────────────── -->
	<PageHero
		title={farmersPage?.heroTitle || "The Hands That Feed Us"}
		subtitle={farmersPage?.heroSubtitle || undefined}
	/>

	<div class="container" data-animate="fade-up">
		<InteractiveMap
			client:only="react"
			coordinates={farmersPage?.locations?.length
				? farmersPage.locations.map((loc) => ({
						lat: loc.lat ?? 0,
						lng: loc.lng ?? 0,
						title: loc.title || undefined,
						description: loc.description || undefined,
						offerings: loc.offerings?.filter((o): o is string => Boolean(o)) || undefined,
						type: (loc.type as 'home' | 'produce' | 'meat' | 'farm') || 'farm',
						url: loc.url || undefined,
						image: loc.image || undefined,
					}))
				: undefined
			}
		/>
	</div>

	{farmPartners.length > 0 && (
		<div class="container farm-list">
			<h2 class="farm-list__heading">Our Farm & Producer Partners</h2>
			<ul class="farm-list__grid">
				{farmPartners.map((loc) => (
					<li class="farm-list__item">
						<h3>{loc.title}</h3>
						{loc.description && <p>{loc.description}</p>}
						{loc.offerings?.filter(Boolean).length ? (
							<p class="farm-list__offerings">
								{loc.offerings.filter(Boolean).join(', ')}
							</p>
						) : null}
					</li>
				))}
			</ul>
		</div>
	)}
</Base>

<style>
	.container {
		padding-top: var(--space-20);
		padding-bottom: var(--space-20);
	}

	.farm-list {
		padding-top: 0;
	}

	.farm-list__heading {
		margin-bottom: var(--space-6);
	}

	.farm-list__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: var(--space-6);
		list-style: none;
		padding: 0;
	}

	.farm-list__item h3 {
		margin-bottom: var(--space-2);
	}

	.farm-list__offerings {
		color: var(--color-text-muted);
		font-size: var(--font-size-sm);
	}
</style>
