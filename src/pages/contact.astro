---
import Base from "@/layouts/Base.astro";
import VegaContactForm from "@/components/sections/VegaContactForm.astro";
import PageHero from "@/components/ui/PageHero.astro";
import DiamondRule from "@/components/ui/DiamondRule.astro";
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { resolveImage } from '@/utils/resolveImage';
import { Image } from 'astro:assets';

const reader = createReader(process.cwd(), keystaticConfig);
const [contactPage, businessInfo] = await Promise.all([
	reader.singletons.contactPage.read(),
	reader.singletons.businessInfo.read(),
]);

const homeIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`;
const clockIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`;

const address = businessInfo?.addressLines?.length
	? businessInfo.addressLines.join(', ')
	: '57 N Broadway, Tarrytown, NY 10591';
const email = businessInfo?.email || 'info@tarrytownlocal.com';
const hours = businessInfo?.hours?.length ? businessInfo.hours : [
	{ days: 'Mon – Fri', hours: '8:00 AM – 8:00 PM' },
	{ days: 'Sat – Sun', hours: '9:00 AM – 9:00 PM' },
];
---

<Base
	title={contactPage?.seoTitle || "Contact Us | Tarrytown Local"}
	description={contactPage?.seoDescription || "Have any questions, comments, or just want to say hi? Fill out some info and we will be in touch shortly."}
>
	<!-- ── Hero ──────────────────────────────────────────────── -->
	<PageHero
		title={contactPage?.heroTitle || "Contact Us"}
		subtitle={contactPage?.heroSubtitle || undefined}
	/>

	<!-- ── Contact body ──────────────────────────────────────── -->
	<section class="contact-body">
		<div class="container">
			<div class="contact-grid">

				<!-- Left: Info cards -->
				<aside class="contact-aside">

					<!-- Visit Us card -->
					<div class="info-card" data-animate="fade-up" data-animate-stagger="0.1">
						<div class="info-card__head">
							<span class="info-card__icon" set:html={homeIcon} />
							<h2 class="info-card__title">Visit Us</h2>
						</div>
						<dl class="info-detail">
							<div class="info-detail__row">
								<dt class="info-detail__term">Location</dt>
								<dd class="info-detail__desc">{address}</dd>
							</div>
							<div class="info-detail__row">
								<dt class="info-detail__term">Inquiries</dt>
								<dd class="info-detail__desc">
									<a href={`mailto:${email}`}>{email}</a>
								</dd>
							</div>
							{businessInfo?.phone && (
								<div class="info-detail__row">
									<dt class="info-detail__term">Phone</dt>
									<dd class="info-detail__desc">
										<a href={`tel:${businessInfo.phone.replace(/\D/g, "")}`}>{businessInfo.phone}</a>
									</dd>
								</div>
							)}
						</dl>
					</div>

					<!-- Our Hours card -->
					<div class="info-card" data-animate="fade-up" data-animate-stagger="0.1">
						<div class="info-card__head">
							<span class="info-card__icon" set:html={clockIcon} />
							<h2 class="info-card__title">Our Hours</h2>
						</div>
						<dl class="info-hours">
							{hours.map((row) => (
								<div class="hours-row">
									<dt>{row.days}</dt>
									<dd>{row.hours}</dd>
								</div>
							))}
						</dl>
					</div>

				</aside>

				<!-- Right: Contact form -->
				<div class="contact-form-col" data-animate="fade-up">
					<VegaContactForm netlify={true} />
				</div>

			</div>
		</div>
	</section>

	<!-- ── Location card ─────────────────────────────────────── -->
	<section class="contact-location">
		<div class="container">
			<div class="come-visit" data-animate="fade-up">
				{contactPage?.comeVisit?.title && <h2 class="come-visit__title">{contactPage.comeVisit.title}</h2>}
				<DiamondRule width={28} class="come-visit__divider" />
				{contactPage?.comeVisit?.body && <p class="come-visit__body">{contactPage.comeVisit.body}</p>}
				{contactPage?.comeVisit?.closing && <p class="come-visit__closing">{contactPage.comeVisit.closing}</p>}
			</div>

			<div class="location-card" data-animate="fade-up">
				<div class="location-grid">
					<div class="location-photo-wrap">
						{contactPage?.storefrontImage ? (() => {
							const img = resolveImage(contactPage.storefrontImage);
							return img
								? <Image class="location-photo" src={img} alt={contactPage.storefrontImageAlt || "Tarrytown Local storefront"} />
								: <img class="location-photo" src={contactPage.storefrontImage} alt={contactPage.storefrontImageAlt || "Tarrytown Local storefront"} loading="lazy" />;
						})() : (
							<div class="location-photo-placeholder" />
						)}
					</div>
					{businessInfo?.mapEmbedUrl && (
						<div class="location-map-wrap">
							<iframe
								class="location-map"
								src={businessInfo.mapEmbedUrl}
								title="Tarrytown Local on Google Maps"
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
							></iframe>
						</div>
					)}
				</div>
			</div>
		</div>
	</section>
</Base>

<style>
	.contact-location {
		background: transparent;
		padding: 1rem 0 5rem;
	}

	.come-visit {
		text-align: center;
		max-width: 560px;
		margin: 0 auto 3rem;
	}

	.come-visit__title {
		font-size: clamp(1.5rem, 3vw, 2rem);
		margin-bottom: 1rem;
	}

	:global(.come-visit__divider) {
		margin: 0 auto 1.5rem;
	}

	.come-visit__body {
		font-size: 1rem;
		color: var(--color-text-muted);
		line-height: 1.8;
		margin-bottom: 0.5rem;
	}

	.come-visit__closing {
		font-family: var(--font-secondary), sans-serif;
		font-size: 1.15rem;
		color: var(--color-primary);
		margin: 0;
	}

	.location-card {
		background: var(--color-bg, #FAF6EE);
		border: 2px dashed var(--color-border-dashed, #6B9C86);
		border-radius: var(--radius-dashed, 20px);
		padding: 1rem;
	}

	.location-grid {
		display: grid;
		grid-template-columns: 2fr 3fr;
		gap: 1rem;
		height: 440px;
	}

	.location-photo-wrap,
	.location-map-wrap {
		border-radius: 0;
		overflow: hidden;
		height: 100%;
	}

	.location-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
	}

	.location-photo-placeholder {
		width: 100%;
		height: 100%;
		background: var(--color-bg-muted, #F1EADD);
	}

	.location-map {
		width: 100%;
		height: 100%;
		border: none;
		display: block;
	}

	@media (max-width: 768px) {
		.location-grid {
			grid-template-columns: 1fr;
			height: auto;
		}

		.location-photo-wrap {
			aspect-ratio: 4 / 3;
			height: auto;
		}

		.location-map-wrap {
			aspect-ratio: 4 / 3;
			height: auto;
		}
	}

	.contact-body {
		background: transparent;
		padding: 3rem 0 5rem;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 2fr 3fr;
		gap: 2rem;
		align-items: start;
	}

	@media (max-width: 768px) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}

	.contact-aside {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.info-card {
		background: var(--color-bg, #FAF6EE);
		border: 2px dashed var(--color-border-dashed, #6B9C86);
		padding: 1.75rem;
		border-radius: var(--radius-dashed, 20px);
	}

	.info-card__head {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-bottom: 1.25rem;
	}

	.info-card__icon {
		display: flex;
		align-items: center;
		color: var(--color-accent, #7C2E28);
	}

	.info-card__icon :global(svg) {
		width: 18px;
		height: 18px;
	}

	.info-card__title {
		font-family: var(--font-primary), sans-serif;
		font-size: 1rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--color-charcoal, #221E1A);
	}

	.info-detail {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.info-detail__row {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.info-detail__term {
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-light, #9A9186);
	}

	.info-detail__desc {
		font-size: 0.92rem;
		color: var(--color-charcoal, #221E1A);
		line-height: 1.5;
	}

	.info-detail__desc a {
		color: var(--color-charcoal, #221E1A);
		text-decoration: none;
		border-bottom: 1px solid var(--color-border, #E4DCCB);
		transition: border-color 0.2s ease, color 0.2s ease;
	}

	.info-detail__desc a:hover {
		color: var(--color-primary, #2E4A3B);
		border-bottom-color: var(--color-primary, #2E4A3B);
	}

	.info-hours {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.hours-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--color-border-light, #EFE8DA);
	}

	.hours-row:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.hours-row dt {
		font-size: 0.88rem;
		color: var(--color-text-muted, #6B6560);
	}

	.hours-row dd {
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--color-charcoal, #221E1A);
	}
</style>
