---
import Base from "@/layouts/Base.astro";
import { createReader } from "@keystatic/core/reader";
import keystaticConfig from '../../keystatic.config';
import VegaMainHero from "@/components/sections/VegaMainHero.astro";
import VegaCommitments from "@/components/sections/VegaCommitments.astro";
import VegaSourcingStandards from "@/components/sections/VegaSourcingStandards.astro";
import VegaNewsletterSignup from "@/components/sections/VegaNewsletterSignup.astro";
import VegaTeam from "@/components/sections/VegaTeam.astro";

const reader = createReader(process.cwd(), keystaticConfig);
const aboutpage = await reader.singletons.aboutpage.read();
---

<Base
	title={aboutpage?.seoTitle || "Tarrytown Local | About"}
	description={aboutpage?.seoDescription || "Tarrytown Local is a restaurant in Tarrytown, NY. We serve seasonal, locally-sourced dishes that celebrate the bounty of our region."}
>
	<!-- Hero -->
	<VegaMainHero
		eyebrow={aboutpage?.hero?.eyebrow || ''}
		title={aboutpage?.hero?.headline || 'Rooted In {real food}. Built for {our community}.'}
		description={aboutpage?.hero?.description || ''}
		imageSrc={aboutpage?.hero?.image || "/assets/vega-hero-image.jpg"}
		buttons={
			aboutpage?.hero?.buttons?.length
				? aboutpage.hero.buttons.map((btn) => ({ text: btn.text, url: btn.url }))
				: [
						{ text: 'Peek The Menu', url: '/menu' },
						{ text: 'Our Story', url: '/about' },
					]
		}
	/>

	<!-- Commitments -->
	<VegaCommitments
		sectionTitle={aboutpage?.commitments?.sectionTitle || "Our Commitments"}
		sectionSubtitle={aboutpage?.commitments?.sectionSubtitle || undefined}
		items={(aboutpage?.commitments?.items ?? []).map((item) => ({
			title: item.title,
			description: item.description,
			tagline: item.tagline || undefined,
			variant: (item.variant as 'light' | 'dark') || 'light',
		}))}
	/>

	<!-- Sourcing Standards -->
	<VegaSourcingStandards
		title={aboutpage?.sourcingStandards?.title || "Our sourcing standards"}
		watermarkText={aboutpage?.sourcingStandards?.watermarkText || undefined}
		body={aboutpage?.sourcingStandards?.body || undefined}
		image={aboutpage?.sourcingStandards?.image?.src ? {
			src: aboutpage.sourcingStandards.image.src,
			alt: aboutpage.sourcingStandards.image.alt || '',
			caption: aboutpage.sourcingStandards.image.caption || undefined,
		} : undefined}
		items={(aboutpage?.sourcingStandards?.items ?? []).map((item) => ({
			title: item.title,
			description: item.description,
		}))}
	/>

	<!-- Team -->
	<VegaTeam
		sectionTitle={aboutpage?.team?.sectionTitle || "Meet the Team"}
		subtitle={aboutpage?.team?.subtitle || undefined}
		members={(aboutpage?.team?.members ?? []).map((member) => ({
			name: member.name,
			role: member.role,
			bio: (member.bio || '').split('\n\n').filter(Boolean),
			image: member.image || undefined,
			imageAlt: member.imageAlt || undefined,
			socials: member.socials?.length
				? member.socials.map((s) => ({
						platform: s.platform as 'instagram' | 'tiktok' | 'twitter' | 'linkedin' | 'facebook' | 'youtube' | 'website',
						url: s.url,
						label: s.label || undefined,
					}))
				: undefined,
		}))}
	/>

	<!-- Newsletter -->
	<VegaNewsletterSignup
		title={aboutpage?.newsletter?.title || "Stay in the Loop"}
		description={aboutpage?.newsletter?.description || "Sign up for our newsletter to get the latest updates on our opening, menu launches, and special events. We promise to only send you the good stuff."}
		placeholder={aboutpage?.newsletter?.placeholder || "Enter your email address"}
		buttonText={aboutpage?.newsletter?.buttonText || "Subscribe"}
	/>
</Base>
