---
import Base from "@/layouts/Base.astro";
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { resolveImage } from '@/utils/resolveImage';
import VegaMainHero from "@/components/sections/VegaMainHero.astro";
import VegaInquiryForm from "@/components/sections/VegaInquiryForm.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";

const reader = createReader(process.cwd(), keystaticConfig);
const eventsPage = await reader.singletons.eventsPage.read();
---

<Base
	title={eventsPage?.seoTitle || "Events & Catering"}
	description={eventsPage?.seoDescription || "Onsite private events and offsite catering, all built around the same food we serve and sell."}
>
	<!-- Hero -->
	<VegaMainHero
		variant={eventsPage?.hero?.style || 'split'}
		size="compact"
		eyebrow={eventsPage?.hero?.eyebrow || 'Events & Catering'}
		title={eventsPage?.hero?.headline || 'We want to feed you and your friends.'}
		description={eventsPage?.hero?.description || undefined}
		imageSrc={resolveImage(eventsPage?.hero?.image)}
	/>

	<!-- Examples -->
	{eventsPage?.examples?.length ? (
		<section class="examples section">
			<div class="container">
				<p class="examples__lead" data-animate="fade-up">We can do it all — from</p>
				<div class="examples__list">
					{eventsPage.examples.map((example, i) => (
						<div class="example-card" data-animate="fade-up-sm" data-animate-stagger="0.08">
							<span class="example-diamond">
								<span class="example-diamond__bg" aria-hidden="true"></span>
								<span class="example-diamond__num">{String(i + 1).padStart(2, '0')}</span>
							</span>
							<p class="example-card__text">{example}</p>
						</div>
					))}
				</div>
			</div>
		</section>
	) : null}

	<!-- Inquiry -->
	<section class="event-inquiry section">
		<div class="container">
			<SectionHeader
				title={eventsPage?.inquiry?.heading || 'Planning Something? Tell Us About It!'}
				subtitle={eventsPage?.inquiry?.body || undefined}
				align="center"
				data-animate="fade-up"
			/>

			<VegaInquiryForm
				formName="event-inquiry"
				successPath="/events?success=true"
				submitLabel="Send Inquiry"
				fields={[
					{ name: 'name', label: 'Your Name', required: true },
					{ name: 'email', label: 'Email Address', type: 'email', required: true },
					{ name: 'phone', label: 'Phone Number', type: 'tel' },
					{ name: 'event-type', label: 'Event Type', placeholder: 'Private dinner, catering, tasting menu...' },
					{ name: 'date', label: 'Date', type: 'date' },
					{ name: 'guests', label: 'Estimated Guest Count', type: 'number' },
					{ name: 'details', label: 'Tell Us More', type: 'textarea', fullWidth: true, required: true },
				]}
			/>
		</div>
	</section>
</Base>

<style>
	.examples__lead {
		text-align: center;
		font-family: var(--font-primary), sans-serif;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--color-charcoal);
		margin-bottom: 2.5rem;
	}

	.examples__list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	@media (max-width: 700px) {
		.examples__list {
			grid-template-columns: 1fr;
		}
	}

	.example-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-dashed);
		padding: 2.75rem 1.5rem 1.75rem;
		text-align: center;
		transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
	}

	.example-card:hover {
		transform: translateY(-6px);
		box-shadow: var(--shadow-hard);
		border-color: var(--color-accent);
	}

	/* Badge floats above the card, straddling the top edge.
	   The number stays upright — only the diamond behind it spins on hover. */
	.example-diamond {
		position: absolute;
		top: -24px;
		left: 50%;
		transform: translateX(-50%);
		flex-shrink: 0;
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.example-diamond__bg {
		position: absolute;
		inset: 0;
		background: var(--color-accent);
		transform: rotate(45deg);
		transition: transform 0.4s ease;
	}

	.example-card:hover .example-diamond__bg {
		transform: rotate(135deg) scale(1.1);
	}

	.example-diamond__num {
		position: relative;
		z-index: 1;
		font-family: var(--font-primary), sans-serif;
		font-size: 0.85rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		color: var(--color-bg, #FAF6EE);
	}

	.example-card__text {
		font-family: var(--font-primary), sans-serif;
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-charcoal);
		line-height: 1.5;
		margin: 0;
	}
</style>
