---
import Base from "@/layouts/Base.astro";
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { resolveImage } from '@/utils/resolveImage';
import VegaMainHero from "@/components/sections/VegaMainHero.astro";
import VegaSourcingStandards from "@/components/sections/VegaSourcingStandards.astro";
import VegaGrainsTable from "@/components/sections/VegaGrainsTable.astro";
import SectionHeader from "@/components/ui/SectionHeader.astro";

const reader = createReader(process.cwd(), keystaticConfig);
const bakeryPage = await reader.singletons.bakeryPage.read();

const grainParagraphs = (bakeryPage?.workingWithGrain?.body || '').split('\n\n').filter(Boolean);
---

<Base
	title={bakeryPage?.seoTitle || "Bakery"}
	description={bakeryPage?.seoDescription || "We mill 100% of our flour in-house on a stone mill, using grains from regional farms."}
>
	<!-- Hero -->
	<VegaMainHero
		eyebrow={bakeryPage?.hero?.eyebrow || 'Bakery'}
		title={bakeryPage?.hero?.headline || 'Most bakeries buy flour. We start with grain.'}
		description={bakeryPage?.hero?.description || undefined}
		imageSrc={resolveImage(bakeryPage?.hero?.image)}
	/>

	<!-- Philosophy -->
	<VegaSourcingStandards
		title={bakeryPage?.philosophy?.title || 'Our Philosophy'}
		watermarkText={bakeryPage?.philosophy?.watermarkText || undefined}
		body={bakeryPage?.philosophy?.body || undefined}
		items={(bakeryPage?.philosophy?.items ?? []).map((item) => ({
			title: item.title,
			description: item.description,
		}))}
	/>

	<!-- Working With The Grain -->
	{grainParagraphs.length > 0 && (
		<section class="working-grain section">
			<div class="container">
				<SectionHeader
					title={bakeryPage?.workingWithGrain?.title || 'Working with the grain, not against it'}
					align="center"
					data-animate="fade-up"
				/>
				{grainParagraphs.map((p) => <p class="grain-para" data-animate="fade-up-sm">{p}</p>)}
			</div>
		</section>
	)}

	<!-- Grains Table -->
	{bakeryPage?.grains?.length ? (
		<VegaGrainsTable
			sectionTitle="Primary Grains on Our Rotation"
			grains={bakeryPage.grains.map((g) => ({
				category: g.category,
				varieties: (g.varieties ?? []).map((v) => ({ name: v.name, farm: v.farm || undefined, location: v.location || undefined })),
			}))}
		/>
	) : null}
</Base>

<style>
	.grain-para {
		font-size: 1rem;
		color: var(--color-text-muted);
		line-height: 1.85;
		text-align: center;
		max-width: 700px;
		margin-inline: auto;
		margin-bottom: 1.5rem;
	}
	.grain-para:last-child {
		margin-bottom: 0;
	}
</style>
