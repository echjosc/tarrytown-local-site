---
import VegaFooter from '@/components/sections/VegaFooter.astro';
import VegaNav from '@/components/sections/VegaNav.astro';
import Seo from '@/components/seo/Seo.astro';
import Schema from '@/components/seo/Schema.astro';
import FormSuccessModal from '@/components/ui/FormSuccessModal.astro';
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { resolveImage } from '@/utils/resolveImage';
import { localBusiness, parseOpeningHours } from '@/lib/schemas/schemas';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	canonical?: string;
	noIndex?: boolean;
	ogType?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
}

const {
	title,
	description,
	ogImage,
	canonical,
	noIndex,
	ogType,
	publishedTime,
	modifiedTime,
} = Astro.props;

const reader = createReader(process.cwd(), keystaticConfig);
const businessInfo = await reader.singletons.businessInfo.read();

const logoSrc = resolveImage(businessInfo?.logo);
const logoAlt = businessInfo?.name || 'Tarrytown Local';

const siteUrl = Astro.site ?? new URL('https://tarrytownlocal.com');
const [addressStreet, addressCityStateZip] = businessInfo?.addressLines ?? [];
const cityStateZipMatch = addressCityStateZip?.match(/^(.+),\s*([A-Z]{2})\s+(\d{5})$/);
const latMatch = businessInfo?.mapEmbedUrl?.match(/!3d(-?\d+\.\d+)/);
const lngMatch = businessInfo?.mapEmbedUrl?.match(/!2d(-?\d+\.\d+)/);

const businessSchema = localBusiness({
	type: 'Restaurant',
	name: businessInfo?.name || 'Tarrytown Local',
	description:
		'Neighborhood restaurant and small grocery store in Tarrytown, NY, focused on local, healthful food.',
	url: siteUrl.href,
	telephone: businessInfo?.phone || undefined,
	email: businessInfo?.email || undefined,
	address: {
		street: addressStreet || '57 N Broadway',
		city: cityStateZipMatch?.[1] || 'Tarrytown',
		state: cityStateZipMatch?.[2] || 'NY',
		zip: cityStateZipMatch?.[3] || '10591',
	},
	geo: latMatch && lngMatch ? { lat: parseFloat(latMatch[1]), lng: parseFloat(lngMatch[1]) } : undefined,
	logo: new URL('/images/business/logo.png', siteUrl).href,
	image: new URL('/images/business/logo.png', siteUrl).href,
	sameAs: businessInfo?.socials?.map((s) => s.url) ?? [],
	openingHours: parseOpeningHours(businessInfo?.hours ?? []),
	hasMenu: new URL('/menu', siteUrl).href,
});

const navLinks = [
	{ label: 'Home', url: '/' },
	{
		label: 'About',
		children: [
			{ label: 'Our Team', url: '/our-team' },
			{ label: 'Our Story', url: '/our-story' },
			{ label: 'Where We Get Our Food', url: '/farmers' },
			{ label: 'FAQs', url: '/our-story#faq' },
		],
	},
	{
		label: 'What We Do',
		children: [
			{ label: 'Restaurant', url: '/restaurant' },
			{ label: 'Bakery', url: '/bakery' },
			{ label: 'Grocery', url: '/grocery' },
			{ label: 'Events & Catering', url: '/events' },
		],
	},
	{ label: 'Contact', url: '/contact' },
	{ label: 'The Blog', url: '/blog' },
];

const footerExploreLinks = [
	{ label: 'Home', url: '/' },
	{ label: 'Our Team', url: '/our-team' },
	{ label: 'Our Story', url: '/our-story' },
	{ label: 'Where We Get Our Food', url: '/farmers' },
	{ label: 'Contact', url: '/contact' },
	{ label: 'The Blog', url: '/blog' },
];

const footerWhatWeDoLinks = [
	{ label: 'Menu', url: '/menu' },
	{ label: 'Restaurant', url: '/restaurant' },
	{ label: 'Bakery', url: '/bakery' },
	{ label: 'Grocery', url: '/grocery' },
	{ label: 'Events & Catering', url: '/events' },
];
---

<!doctype html>
<html lang="en" class="no-js">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<Font cssVariable='--font-libre-franklin' />
		<Font cssVariable='--font-roboto' />
		<Seo
			title={title}
			description={description}
			ogImage={ogImage}
			canonical={canonical}
			noIndex={noIndex}
			ogType={ogType}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
		/>
		<Schema item={businessSchema} />
	<script is:inline>
		document.documentElement.classList.replace('no-js', 'js');
		// Safety net for TOTAL script failure only (blocked/never loaded) —
		// not for animations still waiting on scroll. registerScrollAnimations()
		// sets window.__scrollAnimBooted the moment it runs, whether or not GSAP
		// itself succeeds (that failure path already reveals content on its own).
		// So this only fires if the module script never started at all.
		setTimeout(() => {
			if (!window.__scrollAnimBooted) {
				document.querySelectorAll('[data-animate]').forEach((el) => {
					el.style.opacity = '1';
					el.style.transform = 'none';
				});
			}
		}, 5000);
	</script>
	</head>
	<body>
		<VegaNav
			logoSrc={logoSrc}
			logoAlt={logoAlt}
			links={navLinks}
			cta={{ label: 'Menu', url: '/menu' }}
		/>

		<main class="main-content">
			<slot />
		</main>

		<FormSuccessModal />

		<VegaFooter
			logoSrc={logoSrc}
			logoAlt={logoAlt}
			tagline="Your guide to the best of Tarrytown, NY."
			phone={businessInfo?.phone || undefined}
			socials={businessInfo?.socials?.map((s) => ({
				platform: s.platform as 'instagram' | 'pinterest' | 'facebook' | 'tiktok' | 'twitter',
				url: s.url,
			})) ?? []}
			columns={[
				{
					heading: 'Explore',
					links: footerExploreLinks,
				},
				{
					heading: 'What We Do',
					links: footerWhatWeDoLinks,
				},
				{
					heading: 'Resources',
					links: [
						{ label: 'FAQs', url: '/our-story#faq' },
						{ label: 'Privacy Policy', url: '/privacy' },
						{ label: 'Terms of Service', url: '/terms' },
					],
				},
			]}
			/>
	</body>
</html>

<script>
	import { registerScrollAnimations } from '@/lib/utils/animations';
	import { deferIframeLoad } from '@/lib/utils/deferredIframes';
	import { loadAnalytics } from '@/lib/utils/analytics';
	registerScrollAnimations();
	deferIframeLoad();
	loadAnalytics('G-7MB493QBVR');

	try {
		const [{ default: Lenis }, { default: gsap }, { ScrollTrigger }] = await Promise.all([
			import('lenis'),
			import('gsap'),
			import('gsap/ScrollTrigger'),
		]);

		gsap.registerPlugin(ScrollTrigger);

		ScrollTrigger.config({ ignoreMobileResize: true });

		const lenis = new Lenis({ lerp: 0.25 });

		gsap.ticker.add((time) => {
			lenis.raf(time * 1000);
		});

		lenis.on('scroll', () => ScrollTrigger.update());

		gsap.ticker.lagSmoothing(0);
	} catch (err) {
		console.error('Smooth scroll setup failed', err);
	}
</script>

<style>
.main-content {
	flex: 1;
}
</style>
