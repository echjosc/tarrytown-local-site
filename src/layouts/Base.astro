---
import VegaFooter from '@/components/sections/VegaFooter.astro';
import VegaNav from '@/components/sections/VegaNav.astro';
import Seo from '@/components/seo/Seo.astro';
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { resolveImage } from '@/utils/resolveImage';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	canonical?: string;
	noIndex?: boolean;
	ogType?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
}

const {
	title,
	description,
	ogImage,
	canonical,
	noIndex,
	ogType,
	publishedTime,
	modifiedTime,
} = Astro.props;

const reader = createReader(process.cwd(), keystaticConfig);
const businessInfo = await reader.singletons.businessInfo.read();

const logoSrc = resolveImage(businessInfo?.logo);
const logoAlt = businessInfo?.name || 'Tarrytown Local';

const navLinks = [
	{ label: 'Home', url: '/' },
	{
		label: 'About',
		children: [
			{ label: 'Our Team', url: '/our-team' },
			{ label: 'Our Story', url: '/our-story' },
			{ label: 'Where We Get Our Food', url: '/farmers' },
			{ label: 'FAQs', url: '/our-story#faq' },
		],
	},
	{
		label: 'What We Do',
		children: [
			{ label: 'Menu', url: '/menu' },
			{ label: 'Restaurant', url: '/restaurant' },
			{ label: 'Bakery', url: '/bakery' },
			{ label: 'Grocery', url: '/grocery' },
			{ label: 'Events & Catering', url: '/events' },
		],
	},
	{ label: 'Contact', url: '/contact' },
	{ label: 'The Blog', url: '/blog' },
];

const footerExploreLinks = [
	{ label: 'Home', url: '/' },
	{ label: 'Our Team', url: '/our-team' },
	{ label: 'Our Story', url: '/our-story' },
	{ label: 'Where We Get Our Food', url: '/farmers' },
	{ label: 'Contact', url: '/contact' },
	{ label: 'The Blog', url: '/blog' },
];

const footerWhatWeDoLinks = [
	{ label: 'Menu', url: '/menu' },
	{ label: 'Restaurant', url: '/restaurant' },
	{ label: 'Bakery', url: '/bakery' },
	{ label: 'Grocery', url: '/grocery' },
	{ label: 'Events & Catering', url: '/events' },
];
---

<!doctype html>
<html lang="en" class="no-js">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<Font cssVariable='--font-libre-franklin' preload />
		<Font cssVariable='--font-roboto' preload />
		<Seo
			title={title}
			description={description}
			ogImage={ogImage}
			canonical={canonical}
			noIndex={noIndex}
			ogType={ogType}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
		/>
	<script is:inline>document.documentElement.classList.replace('no-js', 'js')</script>
	</head>
	<body>
		<VegaNav
			logoSrc={logoSrc}
			logoAlt={logoAlt}
			links={navLinks}
			cta={{ label: 'Menu', url: '/menu' }}
		/>

		<main class="main-content">
			<slot />
		</main>

		<VegaFooter
			logoSrc={logoSrc}
			logoAlt={logoAlt}
			tagline="Your guide to the best of Tarrytown, NY."
			phone={businessInfo?.phone || undefined}
			socials={businessInfo?.socials?.map((s) => ({
				platform: s.platform as 'instagram' | 'pinterest' | 'facebook' | 'tiktok' | 'twitter',
				url: s.url,
			})) ?? []}
			columns={[
				{
					heading: 'Explore',
					links: footerExploreLinks,
				},
				{
					heading: 'What We Do',
					links: footerWhatWeDoLinks,
				},
				{
					heading: 'Resources',
					links: [
						{ label: 'FAQs', url: '/our-story#faq' },
						{ label: 'Privacy Policy', url: '/privacy' },
						{ label: 'Terms of Service', url: '/terms' },
					],
				},
			]}
			/>
	</body>
</html>

<script>
	import Lenis from 'lenis';
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	ScrollTrigger.config({ ignoreMobileResize: true });

	const lenis = new Lenis({ lerp: 0.25 });

	gsap.ticker.add((time) => {
		lenis.raf(time * 1000);
	});

	lenis.on('scroll', () => ScrollTrigger.update());

	gsap.ticker.lagSmoothing(0);

	import { registerScrollAnimations } from '@/lib/utils/animations';
	registerScrollAnimations();
</script>

<style>
.main-content {
	flex: 1;
}
</style>
